---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/office.css';
---
<BaseLayout
  title="Autonomous 7-Agent Office & Spatial Telemetry — thio.dev"
  description="Real-time interactive command bridge and 2D/3D spatial telemetry for Herdi Agusthio's 7-agent autonomous engineering organization."
  canonicalPath="/office"
  schemaType="WebSite"
  active="office"
  wide={true}
>

    <main id="main" class="wrap main-container">
      <!-- Telemetry Header -->
      <section class="office-page-hero">
        <div class="meta-status">
          <span class="status-indicator"></span>
          <span class="mono-label">[SWARM_TELEMETRY: OPERATIONAL]</span>
          <span class="mono-label">[AGENTS: 7 ACTIVE]</span>
          <span class="mono-label">[MEM_INVARIANT: &gt;=500MB HEADROOM OK]</span>
        </div>
        <h1 class="page-title">Autonomous Multi-Agent Command Bridge</h1>
        <p class="hero-desc">
          Live spatial telemetry and mission control for Thio's 7-agent specialist engineering workforce.
          Featuring dual <strong>2D Pixel-Art</strong> and <strong>3D Three.js</strong> environments with interactive agent dossiers.
        </p>
      </section>

      <!-- MAIN OFFICE STAGE CONTAINER -->
      <div class="virtual-office-layout">
        <div class="virtual-office-stage-col">
          <!-- Top HUD Bar -->
          <div class="office-stage-header">
            <!-- Left: Gateway running pill (LIVE-004) -->
            <div class="stage-gateway-pill live" id="gatewayPill">
              <span class="gateway-pulse-icon">∿</span>
              <span id="gatewayStatusText">Swarm Fleet — Live Telemetry</span>
              <span class="gateway-live-dot"></span>
              <span class="freshness-label" id="freshnessLabel">Updated just now</span>
            </div>

            <!-- Center: Room Navigator & 2D/3D View Toggle -->
            <div class="stage-room-navigator">
              <div class="room-nav-control" id="roomNavControlWrap">
                <button type="button" id="officeNavPrev" class="room-nav-arrow" aria-label="Previous room"><span aria-hidden="true">‹</span></button>
                <div class="room-nav-title-box">
                  <span id="officeRoomTitle">Workspace</span>
                  <span id="officeRoomCount" class="room-nav-count-badge">5</span>
                </div>
                <button type="button" id="officeNavNext" class="room-nav-arrow" aria-label="Next room"><span aria-hidden="true">›</span></button>
                <span id="officeDayNightPill" class="day-night-chip"><span aria-hidden="true">☀️</span> daytime</span>
              </div>
              <div class="view-toggle" id="officeViewToggle">
                <button type="button" id="toggleView2D" class="active" aria-pressed="true" title="2D Pixel-Art Office">2D</button>
                <button type="button" id="toggleView3D" aria-pressed="false" title="Interactive 3D Isometric Office">3D</button>
              </div>
            </div>

            <!-- Right: Status Summary Pills -->
            <div class="stage-status-pills">
              <span class="status-summary-pill working"><span class="summary-dot green"></span> <b id="officeHeaderWorkingCount">5</b> working</span>
              <span class="status-summary-pill idle"><span class="summary-dot gray"></span> <b id="officeHeaderIdleCount">3</b> standby</span>
              <span class="status-summary-pill offline"><span class="summary-dot dark"></span> <b>0</b> offline</span>
              <button type="button" id="refreshOfficeBtn" class="office-refresh-btn" aria-label="Refresh live data"><span aria-hidden="true">🔄</span></button>
              <span id="officeLiveStatus" class="sr-only" role="status"></span>
            </div>
          </div>

          <!-- THE VIRTUAL OFFICE VIEWPORT (2D STAGE) -->
          <div id="virtualOffice2DStage" class="virtual-office-viewport">
            <!-- WORKSPACE ROOM -->
            <div id="officeWorkspaceRoom" class="office-room-stage workspace-stage">
              <!-- Back Wall Decor -->
              <div class="office-back-wall" aria-hidden="true">
                <!-- Left Window -->
                <div class="office-window window-left">
                  <div class="window-glass">
                    <div class="cloud-drift c1"></div>
                    <div class="cloud-drift c2"></div>
                    <div class="night-sky-element moon"></div>
                    <div class="night-sky-element star s1"></div>
                    <div class="night-sky-element star s2"></div>
                  </div>
                  <div class="window-frame-bar h"></div>
                  <div class="window-frame-bar v"></div>
                </div>

                <!-- Digital Wall Clock -->
                <div class="office-wall-clock" id="officeWallClock" title="WIB Local Time (UTC+7)">
                  <span class="clock-icon">🕒</span>
                  <span id="clockDigits" class="clock-digits">14:40</span>
                </div>

                <!-- Center Door -->
                <div class="office-door">
                  <div class="door-frame">
                    <div class="door-panel">
                      <div class="door-window"></div>
                      <div class="door-knob"></div>
                    </div>
                  </div>
                </div>

                <!-- Water Dispenser ("Galon Air") -->
                <div class="office-galon" title="Water Dispenser · Hot & Cold">
                  <div class="galon-bottle">
                    <div class="galon-water-level"></div>
                    <div class="galon-bubble"></div>
                  </div>
                  <div class="galon-body">
                    <div class="galon-faucet hot"></div>
                    <div class="galon-faucet cold"></div>
                    <div class="galon-drip"></div>
                  </div>
                </div>

                <!-- Right Window -->
                <div class="office-window window-right">
                  <div class="window-glass">
                    <div class="cloud-drift c1"></div>
                    <div class="cloud-drift c2"></div>
                    <div class="night-sky-element moon"></div>
                    <div class="night-sky-element star s1"></div>
                    <div class="night-sky-element star s2"></div>
                  </div>
                  <div class="window-frame-bar h"></div>
                  <div class="window-frame-bar v"></div>
                </div>
              </div>

              <!-- Left Wall Bookshelf -->
              <div class="office-bookshelf" title="Engineering SSOT Library (second-brain)">
                <div class="shelf-row"><span class="book b1"></span><span class="book b2"></span><span class="book b3"></span><span class="book b4"></span><span class="book b5"></span></div>
                <div class="shelf-row"><span class="book b6"></span><span class="book b7"></span><span class="book b1"></span><span class="book b8"></span></div>
                <div class="shelf-row"><span class="book b3"></span><span class="book b5"></span><span class="book b2"></span><span class="book b4"></span></div>
              </div>

              <!-- Right Wall Whiteboard -->
              <div class="office-whiteboard" title="Sprint Architecture: CEO → PRIME → AGENTS">
                <div class="wb-header">AUTONOMOUS FLEET TOPOLOGY</div>
                <div class="wb-diagram">
                  <span class="wb-box">LEADYA</span><span class="wb-arrow">→</span><span class="wb-box">PRIME</span><span class="wb-arrow">→</span><span class="wb-box">GODER / SYSCA / PIXEL</span>
                </div>
                <div class="wb-stickies">
                  <span class="sticky yellow"></span><span class="sticky pink"></span><span class="sticky cyan"></span>
                </div>
              </div>

              <!-- Parquet Floor Surface -->
              <div class="office-floor">
                <!-- Potted Plants in Corners -->
                <div class="office-plant plant-bottom-left" title="Monstera Deliciosa">
                  <div class="plant-pot"></div>
                  <div class="plant-leaves"><i></i><i></i><i></i><i></i></div>
                </div>
                <div class="office-plant plant-bottom-right" title="Snake Plant">
                  <div class="plant-pot"></div>
                  <div class="plant-leaves"><i></i><i></i><i></i><i></i></div>
                </div>

                <!-- 12 Hot Desks Grid (2 rows x 6 desks) -->
                <div class="hot-desks-grid">
                  <!-- Top Row: Desks 1-6 -->
                  <div class="desks-row top-row" id="desksRowTop"></div>
                  
                  <!-- Central Walkway / Meeting Table Area -->
                  <div class="walkway-meeting-area" id="walkwayMeetingArea">
                    <div class="meeting-table" title="Sync Station">
                      <div class="table-surface"></div>
                    </div>
                  </div>

                  <!-- Bottom Row: Desks 7-12 -->
                  <div class="desks-row bottom-row" id="desksRowBottom"></div>
                </div>
              </div>

              <!-- Footer Hint -->
              <div class="stage-footer-bar">
                <span><span aria-hidden="true">💡</span> Click any workstation or agent character to view architecture dossier & charter</span>
              </div>
            </div>

            <!-- LOUNGE ROOM -->
            <div id="officeLoungeRoom" class="office-room-stage lounge-stage" style="display: none;">
              <!-- Lounge Back Wall -->
              <div class="office-back-wall lounge-wall" aria-hidden="true">
                <!-- Left Window -->
                <div class="office-window window-left">
                  <div class="window-glass">
                    <div class="cloud-drift c1"></div>
                    <div class="cloud-drift c2"></div>
                    <div class="night-sky-element moon"></div>
                    <div class="night-sky-element star s1"></div>
                    <div class="night-sky-element star s2"></div>
                  </div>
                  <div class="window-frame-bar h"></div>
                  <div class="window-frame-bar v"></div>
                </div>

                <!-- Digital Wall Clock -->
                <div class="office-wall-clock" title="WIB Local Time (UTC+7)">
                  <span class="clock-icon">🕒</span>
                  <span class="clock-digits clock-digits-lounge">14:40</span>
                </div>

                <!-- Smart Wall TV in the center -->
                <div class="lounge-wall-tv" title="Smart TV · Live Swarm Code Display">
                  <div class="tv-screen">
                    <div class="tv-code-line line-1"><code>const fleet = new AutonomousOrg();</code></div>
                    <div class="tv-code-line line-2"><code>await fleet.sync(&#123; memorySafe: true &#125;);</code></div>
                    <div class="tv-code-line line-3"><code>fleet.verify(&#123; ramHeadroomMB: "&gt;=500" &#125;);</code></div>
                    <div class="tv-scanlines"></div>
                  </div>
                  <div class="tv-mount"></div>
                </div>

                <!-- Right Window -->
                <div class="office-window window-right">
                  <div class="window-glass">
                    <div class="cloud-drift c1"></div>
                    <div class="cloud-drift c2"></div>
                    <div class="night-sky-element moon"></div>
                    <div class="night-sky-element star s1"></div>
                    <div class="night-sky-element star s2"></div>
                  </div>
                  <div class="window-frame-bar h"></div>
                  <div class="window-frame-bar v"></div>
                </div>
              </div>

              <!-- Lounge Floor -->
              <div class="office-floor lounge-floor">
                <!-- Corner Plants -->
                <div class="office-plant plant-bottom-left"><div class="plant-pot"></div><div class="plant-leaves"><i></i><i></i><i></i><i></i></div></div>
                <div class="office-plant plant-bottom-right"><div class="plant-pot"></div><div class="plant-leaves"><i></i><i></i><i></i><i></i></div></div>

                <!-- Lounge Seating Group -->
                <div class="lounge-seating-group">
                  <!-- Left Executive Armchair -->
                  <div class="lounge-armchair-wrap" id="loungeArmchairSlot"></div>

                  <!-- Center Multi-Seater Sofa -->
                  <div class="lounge-sofa-wrap">
                    <div class="lounge-sofa-furniture">
                      <div class="sofa-backrest"></div>
                      <div class="sofa-cushions" id="loungeSofaCrew"></div>
                      <div class="sofa-base"></div>
                    </div>

                    <!-- Coffee Table in Front of Sofa -->
                    <div class="lounge-coffee-table" aria-hidden="true">
                      <div class="coffee-cup" title="Fresh Toraja Coffee"><span class="steam">~</span>☕</div>
                      <div class="coffee-cup" title="Green Tea"><span class="steam">~</span>🍵</div>
                      <div class="table-magazine">TECH ARCHITECTURE</div>
                    </div>
                  </div>

                  <!-- Right Side Table / Lamp -->
                  <div class="lounge-side-table" title="Reading Lamp & Radio">
                    <div class="side-lamp"><div class="lamp-shade"></div><div class="lamp-pole"></div></div>
                    <div class="side-table-base"></div>
                  </div>
                </div>

                <!-- Bottom Status Subtitle -->
                <div class="lounge-footer-status">
                  <span class="lounge-idle-dot">●</span>
                  <span>off the clock · standby mode · token conservation protocol active</span>
                </div>
              </div>
            </div>
          </div>

          <!-- 3D VIRTUAL OFFICE STAGE -->
          <!-- Lucide icons the 3D bundle's toolbar references as #i-<name> (from vps-dashboard's sprite). -->
          <svg class="icon-sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <symbol id="i-mouse" viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="7" /> <path d="M12 6v4" /></symbol>
            <symbol id="i-move" viewBox="0 0 24 24"><path d="M12 2v20" /> <path d="m15 19-3 3-3-3" /> <path d="m19 9 3 3-3 3" /> <path d="M2 12h20" /> <path d="m5 9-3 3 3 3" /> <path d="m9 5 3-3 3 3" /></symbol>
            <symbol id="i-pause" viewBox="0 0 24 24"><rect x="14" y="4" width="4" height="16" rx="1" /> <rect x="6" y="4" width="4" height="16" rx="1" /></symbol>
            <symbol id="i-play" viewBox="0 0 24 24"><polygon points="6 3 20 12 6 21 6 3" /></symbol>
            <symbol id="i-pointer" viewBox="0 0 24 24"><path d="M22 14a8 8 0 0 1-8 8" /> <path d="M18 11v-1a2 2 0 0 0-2-2a2 2 0 0 0-2 2" /> <path d="M14 10V9a2 2 0 0 0-2-2a2 2 0 0 0-2 2v1" /> <path d="M10 9.5V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v10" /> <path d="M18 11a2 2 0 1 1 4 0v3a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" /></symbol>
            <symbol id="i-rotate-ccw" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /> <path d="M3 3v5h5" /></symbol>
            <symbol id="i-zoom-in" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /> <line x1="21" x2="16.65" y1="21" y2="16.65" /> <line x1="11" x2="11" y1="8" y2="14" /> <line x1="8" x2="14" y1="11" y2="11" /></symbol>
          </svg>
          <div id="virtualOffice3DStage" class="office-3d-wrapper" style="display: none;"></div>
        </div>

        <!-- SIDEBAR PANEL -->
        <div class="virtual-office-sidebar">
          <!-- 1. Fleet Roster Quick Nav -->
          <div class="office-sidebar-card">
            <div class="sidebar-card-header">
              <h2 class="sidebar-card-title">
                <span><span aria-hidden="true">🤖</span> Fleet Roster (7)</span>
              </h2>
              <span class="badge active" style="font-size: 10px;">7 Online</span>
            </div>
            <div class="agent-chip-list" id="agentRosterChips">
              <!-- Dynamically populated -->
            </div>
          </div>

          <!-- 2. Live Activity Card -->
          <div class="office-sidebar-card">
            <div class="sidebar-card-header">
              <h2 class="sidebar-card-title">
                <span class="sidebar-pulse-icon" aria-hidden="true">∿</span>
                <span>Live Engineering Activity</span>
              </h2>
              <span class="badge active" style="font-size: 10px;">Live Stream</span>
            </div>
            <div class="live-activity-list" id="sidebarActivityList">
              <!-- Dynamically populated with sanitized engineering activities -->
            </div>
          </div>

          <!-- 3. Channels Card -->
          <div class="office-sidebar-card">
            <div class="sidebar-card-header">
              <h2 class="sidebar-card-title">
                <span><span aria-hidden="true">💬</span> Architecture Channels (6)</span>
              </h2>
              <span class="badge active" style="font-size: 10px;">Connected</span>
            </div>
            <div class="sidebar-channels-list" id="sidebarChannelsList">
              <!-- Dynamically populated with sanitized topic routes -->
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- AGENT DOSSIER INSPECTOR MODAL -->
    <dialog id="stationDetailModal" class="office-dialog" aria-labelledby="modalAgentName">
      <div class="cyber-modal-card">
        <div class="cyber-modal-head">
          <div style="display: flex; align-items: center; gap: 14px;">
            <div class="holo-avatar-pod" style="width: 44px; height: 44px;" aria-hidden="true">
              <div class="holo-avatar-ring"></div>
              <div id="modalAvatar" class="holo-avatar-core" style="width: 36px; height: 36px; font-size: 18px;">👑</div>
            </div>
            <div>
              <!-- autofocus: focus lands on the title, so the Space keyup that opened the dialog can't press Close -->
              <h2 id="modalAgentName" tabindex="-1" autofocus style="font-size: 18px; margin-bottom: 2px; font-weight: 700; color: #f8fafc;">LEADYA</h2>
              <div id="modalAgentRole" style="font-size: 12px; color: var(--accent);">CEO & Chief Orchestrator</div>
            </div>
          </div>
          <button type="button" id="closeStationModalBtn" class="btn-secondary"><span aria-hidden="true">✕</span> Close</button>
        </div>
        <div class="cyber-modal-body">
          <div class="cyber-meta-grid">
            <div class="cyber-meta-cell">
              <span class="meta-label">Current Status</span>
              <strong id="modalStateVal" style="color: #38bdf8;">Working</strong>
            </div>
            <div class="cyber-meta-cell">
              <span class="meta-label">Location / Zone</span>
              <strong id="modalRoomVal">Command Bridge (Station #1)</strong>
            </div>
            <div class="cyber-meta-cell">
              <span class="meta-label">Inference Engine & Tier</span>
              <strong id="modalModelVal">Frontier Reasoning (agenticprojectcombo)</strong>
            </div>
            <div class="cyber-meta-cell">
              <span class="meta-label">Execution Invariant</span>
              <strong id="modalProvenanceVal" style="font-size: 11px;">Deterministic Memory & Review Gate</strong>
            </div>
          </div>

          <div class="cyber-meta-cell">
            <span class="meta-label">Current Attributed Task</span>
            <div id="modalCurrentTask" style="font-size: 13px; font-weight: 600; color: #38bdf8; font-family: var(--font-mono);">None</div>
          </div>

          <div class="cyber-meta-cell">
            <span class="meta-label">Recent Live Activity Trace</span>
            <div id="modalRecentActivity" style="font-size: 12px; color: var(--text-muted); font-family: var(--font-mono);">None</div>
          </div>

          <div class="cyber-meta-cell">
            <span class="meta-label">Public Mission Charter & Philosophy</span>
            <div id="modalMission" style="font-size: 12px; line-height: 1.5; color: var(--text-main); max-height: 140px; overflow-y: auto; white-space: pre-wrap; font-family: var(--font-sans);"></div>
          </div>

          <div class="cyber-meta-cell">
            <span class="meta-label">Domain Skills & Operational Protocols</span>
            <div id="modalSkills" style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px;"></div>
          </div>
        </div>
      </div>
    </dialog>

    <a slot="footer" href="/showcase/autonomous-agent-office" class="back-link">[ READ ARCHITECTURE CASE STUDY → ]</a>

    <!-- Interactive Client (bundled, type-checked) -->
    <script>
      import '../scripts/office';
    </script>
</BaseLayout>

    <style>
      .main-container {
        padding-top: 2rem;
        padding-bottom: 4rem;
        max-width: 1400px;
        margin: 0 auto;
      }
      .office-page-hero {
        border-bottom: 1px solid var(--gray-20);
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
      }
      .meta-status {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: var(--gray-60);
        margin-bottom: 1rem;
      }
      .status-indicator {
        width: 8px;
        height: 8px;
        background: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 8px #10b981;
      }
      .page-title {
        font-family: var(--font-sans);
        font-size: clamp(2rem, 4vw, 2.75rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.5;
        margin-bottom: 0.5rem;
      }
      .hero-desc {
        color: var(--gray-60);
        font-size: 1.05rem;
        max-width: 800px;
        line-height: 1.6;
      }

      /* 2-Column Office Layout. minmax(0, 1fr): a plain 1fr track never shrinks below its widest child. */
      .virtual-office-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 340px;
        gap: 24px;
        align-items: start;
      }

      @media (max-width: 1080px) {
        .virtual-office-layout {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      .virtual-office-stage-col {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .virtual-office-sidebar {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .office-sidebar-card {
        background: #090e17;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 16px;
      }

      .sidebar-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }

      .sidebar-card-title {
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 700;
        color: #f8fafc;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      /* Roster Chips */
      .agent-chip-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .agent-chip-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 8px;
        cursor: pointer;
        transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
      }

      .agent-chip-item:hover {
        background: rgba(56, 189, 248, 0.08);
        border-color: rgba(56, 189, 248, 0.3);
        transform: translateX(2px);
      }

      .chip-avatar {
        font-size: 18px;
      }

      .chip-details {
        flex: 1;
        display: flex;
        flex-direction: column;
      }

      .chip-details strong {
        font-size: 13px;
        color: #f8fafc;
      }

      .chip-details small {
        font-size: 11px;
        color: var(--gray-60);
      }

      /* Activity List */
      .live-activity-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .sidebar-activity-item {
        padding: 10px;
        background: rgba(255, 255, 255, 0.02);
        border-radius: 8px;
        border-left: 2px solid #38bdf8;
      }

      .activity-top {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        margin-bottom: 4px;
      }

      .activity-agent {
        font-family: var(--font-mono);
        font-weight: 700;
        color: #f8fafc;
      }

      .activity-time {
        color: var(--gray-50);
        font-family: var(--font-mono);
      }

      .activity-action {
        font-size: 12px;
        color: var(--gray-70);
        line-height: 1.4;
      }

      /* Channel Rows */
      .sidebar-channels-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .sidebar-channel-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 10px;
        background: rgba(255, 255, 255, 0.02);
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.04);
      }

      .channel-left {
        display: flex;
