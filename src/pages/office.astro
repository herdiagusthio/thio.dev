      ];

      const STATIC_LIVE_ACTIVITIES = [
        { icon: '⚡', agent: 'Prime', role: 'Principal Engineer', action: 'Approved architecture review for Go AI harness', timeAgo: '2m ago' },
        { icon: '🛠️', agent: 'Goder', role: 'Senior Go Engineer', action: 'Passed table-driven tests (go test -race ./...)', timeAgo: '5m ago' },
        { icon: '🛡️', agent: 'Sysca', role: 'Infraguard / DevOps', action: 'VPS memory headroom verified (>= 500MB)', timeAgo: '11m ago' },
        { icon: '👑', agent: 'LEADYA', role: 'Chief Orchestrator', action: 'Synchronized sprint backlog and task dispatch queue', timeAgo: '18m ago' },
        { icon: '🎨', agent: 'Pixel', role: 'Frontend & UI/UX', action: 'Audited WCAG AA color tokens for dark mode console', timeAgo: '24m ago' },
        { icon: '✍️', agent: 'Lexa', role: 'Content Specialist', action: 'Synced architecture case study to thio.dev/showcase', timeAgo: '35m ago' },
        { icon: '🌙', agent: 'Luna', role: 'Product Owner', action: 'Finalized 4-week Go learning syllabus specifications', timeAgo: '48m ago' },
        { icon: '💼', agent: 'Caren', role: 'Executive Assistant', action: 'Scheduled deep-work blocks in developer calendar', timeAgo: '1h ago' }
      ];

      const STATIC_CHANNELS = [
        { name: '#engineering-architecture', target: 'Go systems, concurrency patterns, ADR review gate', status: 'ACTIVE' },
        { name: '#tech-intelligence', target: 'AI breakthroughs, distributed systems radar', status: 'ACTIVE' },
        { name: '#systems-reliability', target: 'VPS telemetry, Caddy proxy, memory guardrail', status: 'ACTIVE' },
        { name: '#product-strategy', target: 'PRDs, backlog prioritization, user journey flows', status: 'ACTIVE' },
        { name: '#content-narrative', target: 'Technical blogging, case studies, JSON-LD schema', status: 'ACTIVE' },
        { name: '#executive-ops', target: 'Executive coordination, calendar, habits', status: 'ACTIVE' }
      ];

      // --------------------------------------------------------------------------
      // Live State (merged from API or fallback)
      // --------------------------------------------------------------------------

      const FALLBACK_AGENTS = STATIC_AGENTS;
      const LIVE_API_URL = 'https://api.thio.103.217.144.64.nip.io/office';
      const FETCH_TIMEOUT_MS = 4000;
      const REFRESH_INTERVAL_MS = 30000;

      let AGENTS = FALLBACK_AGENTS.slice();
      let LIVE_ACTIVITIES = STATIC_LIVE_ACTIVITIES.slice();
      let CHANNELS = STATIC_CHANNELS.slice();
      let isLiveMode = false;
      let lastUpdatedAt = null;

      // --------------------------------------------------------------------------
      // Live Fetch (LIVE-003)
      // --------------------------------------------------------------------------

      async function loadLiveAgentState() {
        try {
          const controller = new AbortController();
          const timeout = setTimeout(() => controller.abort(), FETCH_TIMEOUT_MS);

          const res = await fetch(LIVE_API_URL, {
            cache: 'no-cache',
            signal: controller.signal,
            headers: { 'Accept': 'application/json' },
          });
          clearTimeout(timeout);

          if (!res.ok) {
            throw new Error(`HTTP ${res.status}`);
          }

          const data = await res.json();
          const rawStations = data.agents || data.stations;

          if (!Array.isArray(rawStations) || rawStations.length === 0) {
            throw new Error('Invalid snapshot shape');
          }

          return {
            agents: rawStations,
            data,
            isLive: true,
            updatedAt: data.updatedAt || data.fetchedAt || new Date().toISOString(),
          };
        } catch (e) {
          console.warn('[Office] Live state unavailable, using static fallback:', e);
          return {
            agents: FALLBACK_AGENTS,
            data: null,
            isLive: false,
            updatedAt: null,
          };
        }
      }

      async function fetchLiveOffice() {
        const result = await loadLiveAgentState();
        isLiveMode = result.isLive;
        lastUpdatedAt = result.updatedAt;

        if (result.isLive && result.data) {
          const data = result.data;

          // Merge live stations with static mission/skills (not exposed by public API)
          AGENTS = result.agents.map(liveStation => {
            const staticAgent = FALLBACK_AGENTS.find(a => a.id === liveStation.id);
            return {
              ...(staticAgent || {}),
              ...liveStation,
              mission: staticAgent?.mission || '',
              skills: staticAgent?.skills || [],
            };
          });

          // Merge live activities
          if (Array.isArray(data.liveActivity) && data.liveActivity.length > 0) {
            LIVE_ACTIVITIES = data.liveActivity.map(item => ({
              icon: item.icon || '⚡',
              agent: item.agent,
              role: item.role || '',
              action: item.action,
              timeAgo: item.timeAgo || 'recently',
            }));
          }

          // Merge channels
          if (data.channels && Array.isArray(data.channels.topics)) {
            CHANNELS = data.channels.topics.map(t => ({
              name: typeof t === 'string' ? t : `#${t.category || t.name.toLowerCase().replace(/\s+/g, '-')}`,
              target: typeof t === 'string' ? t : t.name,
              status: typeof t === 'object' && t.status === 'Active' ? 'ACTIVE' : 'IDLE',
            }));
          }
        } else {
          // Revert to fallback arrays
          AGENTS = FALLBACK_AGENTS.slice();
          LIVE_ACTIVITIES = STATIC_LIVE_ACTIVITIES.slice();
          CHANNELS = STATIC_CHANNELS.slice();
        }

        updateHudStatus(result.data?.summary || null);
        updateFreshness();
        return result.isLive;
      }

      function updateFreshness() {
        const freshnessLabel = document.getElementById('freshnessLabel');
        if (!freshnessLabel) return;

        if (!isLiveMode || !lastUpdatedAt) {
          freshnessLabel.textContent = isLiveMode ? 'Updated just now' : 'Static Fallback';
          return;
        }

        const elapsedSec = Math.max(0, Math.floor((Date.now() - new Date(lastUpdatedAt).getTime()) / 1000));
        if (elapsedSec < 10) {
          freshnessLabel.textContent = 'Updated just now';
        } else if (elapsedSec < 60) {
          freshnessLabel.textContent = `Updated ${elapsedSec}s ago`;
        } else if (elapsedSec < 3600) {
          freshnessLabel.textContent = `Updated ${Math.floor(elapsedSec / 60)}m ago`;
        } else {
          freshnessLabel.textContent = `Updated ${Math.floor(elapsedSec / 3600)}h ago`;
        }
      }

      function updateHudStatus(summary) {
        // Update the stage gateway pill (LIVE-004)
        const gatewayPill = document.getElementById('gatewayPill');
        const gatewayStatusText = document.getElementById('gatewayStatusText');
        if (gatewayPill) {
          if (isLiveMode) {
            gatewayPill.classList.remove('static');
            gatewayPill.classList.add('live');
            if (gatewayStatusText) gatewayStatusText.textContent = 'Swarm Fleet — Live Telemetry';
          } else {
            gatewayPill.classList.remove('live');
            gatewayPill.classList.add('static');
            if (gatewayStatusText) gatewayStatusText.textContent = 'Swarm Fleet — Static Fallback';
          }
        }

        // Update the SWARM_TELEMETRY status in the hero HUD
        const monoLabels = document.querySelectorAll('.mono-label');
        if (monoLabels.length >= 1) {
          monoLabels[0].textContent = isLiveMode
            ? '[SWARM_TELEMETRY: LIVE]'
            : '[SWARM_TELEMETRY: STATIC FALLBACK]';
        }
        if (summary && monoLabels.length >= 2) {
          monoLabels[1].textContent = `[AGENTS: ${summary.totalAgents} TRACKED · ${summary.active || summary.working} ACTIVE]`;
        }

        // Update working/idle count pills
        const workingCount = document.getElementById('officeHeaderWorkingCount');
        const idleCount = document.getElementById('officeHeaderIdleCount');
        if (workingCount) {
          workingCount.textContent = summary ? (summary.active || summary.working) : AGENTS.filter(a => ['Working', 'Reviewing', 'Collaborating'].includes(a.state)).length;
        }
        if (idleCount) {
          idleCount.textContent = summary ? summary.idle : AGENTS.filter(a => a.state === 'Idle').length;
        }
      }

      // --------------------------------------------------------------------------
      // Render Engine (unchanged from previous implementation)
      // --------------------------------------------------------------------------

      let currentRoom = 'workspace';
      let currentMode = '2D';
      let office3DInitialized = false;

      function renderPixelCharacterHtml(colors, state = 'idle') {
        const c = colors || { hair: '#18181b', skin: '#fed7aa', shirt: '#3b82f6', pants: '#1e3a8a' };
        return `
          <div class="pixel-character state-${state.toLowerCase()}" style="--hair: ${c.hair}; --skin: ${c.skin}; --shirt: ${c.shirt}; --pants: ${c.pants};">
            <span class="character-hair"></span>
            <span class="character-head"><i></i><b></b></span>
            <span class="character-torso"></span>
            <span class="character-arm left"></span>
            <span class="character-arm right"></span>
            <span class="character-leg left"></span>
            <span class="character-leg right"></span>
          </div>
        `;
      }

      function escapeHtml(str) {
        if (!str) return '';
        return String(str).replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
      }

      function renderOffice2D() {
        const workspaceStations = AGENTS.filter(a => a.room === 'Workspace');
        const loungeStations = AGENTS.filter(a => a.room === 'Lounge');

        // Render Hot Desks
        const desksRowTop = document.getElementById('desksRowTop');
        const desksRowBottom = document.getElementById('desksRowBottom');

        const renderDeskCell = (deskNum) => {
          const agent = workspaceStations.find(a => a.seat === deskNum);
          const isOccupied = Boolean(agent);

          return `
            <div class="office-desk-cell" onclick="${isOccupied ? `openDossierModal('${agent.id}')` : ''}" title="${isOccupied ? `Workstation #${deskNum}: ${agent.name} (${agent.state})` : `Available Hot-Desk #${deskNum}`}">
              ${
                isOccupied
                  ? `
                <div class="desk-speech-bubble" title="${escapeHtml(agent.currentTask)}">
                  <span class="speech-text">${escapeHtml(agent.currentTask)}</span>
                  <span class="speech-badge badge-${agent.state.toLowerCase()}">${agent.state} · ${agent.name}</span>
                </div>
                ${renderPixelCharacterHtml(agent.colors, agent.state)}
              `
                  : ''
              }
              <div class="office-desk-furniture ${isOccupied ? 'occupied' : 'vacant'}">
                <div class="monitor-screen">
                  <div class="screen-content ${isOccupied ? 'screen-on' : 'screen-standby'}">
                    ${isOccupied ? '<div class="code-stream"></div>' : '<div class="standby-dot"></div>'}
                  </div>
                  <div class="monitor-stand"></div>
                </div>
                <div class="desk-surface">
                  <div class="keyboard"></div>
                </div>
                <div class="desk-legs">
                  <div class="leg"></div>
                  <div class="pc-tower"><span class="pc-led ${isOccupied ? 'blinking' : ''}"></span></div>
                  <div class="leg"></div>
                </div>
                <div class="desk-chair ${isOccupied ? 'occupied' : ''}"></div>
              </div>
              <div class="desk-slot-label">Desk #${deskNum}${isOccupied ? ` · ${agent.name}` : ''}</div>
            </div>
          `;
        };

        if (desksRowTop) desksRowTop.innerHTML = [1, 2, 3, 4, 5, 6].map(renderDeskCell).join('');
        if (desksRowBottom) desksRowBottom.innerHTML = [7, 8, 9, 10, 11, 12].map(renderDeskCell).join('');

        // Lounge Rendering
        const armchairSlot = document.getElementById('loungeArmchairSlot');
        const sofaSlot = document.getElementById('loungeSofaCrew');

        const leadAgent = loungeStations.find(a => a.id === 'root') || null;
        const sofaAgents = loungeStations.filter(a => a.id !== leadAgent?.id);

        if (armchairSlot) {
          if (leadAgent) {
            armchairSlot.innerHTML = `
              <div style="position: relative; display: flex; flex-direction: column; align-items: center;" onclick="openDossierModal('${leadAgent.id}')" title="Inspect ${leadAgent.name} (Armchair)">
                <div style="position: absolute; bottom: 36px; z-index: 10;">
                  ${renderPixelCharacterHtml(leadAgent.colors, 'idle')}
                </div>
                <div class="lounge-armchair"></div>
                <div class="seated-agent-tag" style="margin-top: 4px;">${leadAgent.name}</div>
              </div>
            `;
          } else {
            armchairSlot.innerHTML = `<div class="lounge-armchair" title="Reserved for Executive Lead"></div>`;
          }
        }

        if (sofaSlot) {
          sofaSlot.innerHTML = sofaAgents
            .map(
              a => `
            <div class="lounge-seated-agent" onclick="openDossierModal('${a.id}')" title="Inspect ${a.name} (Standby on sofa)">
              <div class="seated-char-wrap">
                ${renderPixelCharacterHtml(a.colors, 'idle')}
              </div>
              <div class="seated-agent-tag">${a.name}</div>
            </div>
          `
            )
            .join('');
        }

        // Sidebar Roster Chips
        const rosterChips = document.getElementById('agentRosterChips');
        if (rosterChips) {
          rosterChips.innerHTML = AGENTS.map(a => `
            <div class="agent-chip-item" onclick="openDossierModal('${a.id}')" title="Inspect ${a.name}">
              <span class="chip-avatar">${a.avatar}</span>
              <div class="chip-details">
                <strong>${a.name}</strong>
                <small>${a.role}</small>
              </div>
              <span class="badge ${['Working', 'Reviewing', 'Collaborating'].includes(a.state) ? 'active' : 'standby'}">${a.state}</span>
            </div>
          `).join('');
        }

        // Sidebar Live Activity
        const activityList = document.getElementById('sidebarActivityList');
        if (activityList) {
          activityList.innerHTML = LIVE_ACTIVITIES.map(item => `
            <div class="sidebar-activity-item">
              <div class="activity-top">
                <span class="activity-agent">${item.icon} ${item.agent}</span>
                <span class="activity-time">${item.timeAgo}</span>
              </div>
              <div class="activity-action">${escapeHtml(item.action)}</div>
            </div>
          `).join('');
        }

        // Sidebar Channels
        const channelsList = document.getElementById('sidebarChannelsList');
        if (channelsList) {
          channelsList.innerHTML = CHANNELS.map(c => `
            <div class="sidebar-channel-row">
              <div class="channel-left">
                <div class="channel-dot"></div>
                <div class="channel-info-wrap">
                  <strong>${c.name}</strong>
                  <small>${c.target}</small>
                </div>
              </div>
              <span class="badge active" style="font-size: 9px;">CONNECTED</span>
            </div>
          `).join('');
        }
      }

      function updateClockAndLighting() {
        const now = new Date();
        const utc = now.getTime() + now.getTimezoneOffset() * 60000;
        const wib = new Date(utc + 7 * 3600000);
        const hours = String(wib.getHours()).padStart(2, '0');
        const minutes = String(wib.getMinutes()).padStart(2, '0');
        const timeStr = `${hours}:${minutes}`;

        const clockEl = document.getElementById('clockDigits');
        const loungeClockEl = document.querySelector('.clock-digits-lounge');
        if (clockEl) clockEl.textContent = timeStr;
        if (loungeClockEl) loungeClockEl.textContent = timeStr;

        const isNight = wib.getHours() < 6 || wib.getHours() >= 18;
        const dayNightPill = document.getElementById('officeDayNightPill');
        if (dayNightPill) {
          dayNightPill.textContent = isNight ? '🌙 nighttime' : '☀️ daytime';
          dayNightPill.className = `day-night-chip ${isNight ? 'night' : 'day'}`;
        }

        const stages = document.querySelectorAll('.office-room-stage');
        stages.forEach(st => {
          if (isNight) st.classList.add('is-night');
          else st.classList.remove('is-night');
        });

        if (office3DInitialized && window.Office3D) {
          window.Office3D.update(AGENTS, isNight);
        }
      }

      function switchRoom(targetRoom) {
        currentRoom = targetRoom;
        const wsEl = document.getElementById('officeWorkspaceRoom');
        const loungeEl = document.getElementById('officeLoungeRoom');
        const titleEl = document.getElementById('officeRoomTitle');
        const countEl = document.getElementById('officeRoomCount');
        const dotWs = document.getElementById('dotWorkspace');
        const dotLg = document.getElementById('dotLounge');

        if (targetRoom === 'workspace') {
          if (wsEl) wsEl.style.display = 'block';
          if (loungeEl) loungeEl.style.display = 'none';
          if (titleEl) titleEl.textContent = 'Workspace';
          if (countEl) countEl.textContent = AGENTS.filter(a => a.room === 'Workspace').length;
          dotWs?.classList.add('active');
          dotLg?.classList.remove('active');
        } else {
          if (wsEl) wsEl.style.display = 'none';
          if (loungeEl) loungeEl.style.display = 'block';
          if (titleEl) titleEl.textContent = 'Lounge';
          if (countEl) countEl.textContent = AGENTS.filter(a => a.room === 'Lounge').length;
          dotLg?.classList.add('active');
          dotWs?.classList.remove('active');
        }
      }

      function switchOfficeMode(mode) {
        currentMode = mode;
        const stage2D = document.getElementById('virtualOffice2DStage');
        const stage3D = document.getElementById('virtualOffice3DStage');
        const btn2D = document.getElementById('toggleView2D');
        const btn3D = document.getElementById('toggleView3D');
        const navWrap = document.getElementById('roomNavControlWrap');
        const dotsWrap = document.getElementById('roomNavDotsWrap');

        if (mode === '3D') {
          btn2D?.classList.remove('active');
          btn3D?.classList.add('active');
          if (stage2D) stage2D.style.display = 'none';
          if (stage3D) stage3D.style.display = 'block';
          if (navWrap) navWrap.style.display = 'none';
          if (dotsWrap) dotsWrap.style.display = 'none';

          if (!office3DInitialized && window.Office3D) {
            window.Office3D.init(stage3D, (station) => {
              openDossierModal(station.id);
            });
            office3DInitialized = true;
          }
          updateClockAndLighting();
        } else {
          btn3D?.classList.remove('active');
          btn2D?.classList.add('active');
          if (stage3D) stage3D.style.display = 'none';
          if (stage2D) stage2D.style.display = 'block';
          if (navWrap) navWrap.style.display = 'flex';
          if (dotsWrap) dotsWrap.style.display = 'flex';
        }
      }

      function openDossierModal(agentId) {
        const agent = AGENTS.find(a => a.id === agentId);
        if (!agent) return;

        const modal = document.getElementById('stationDetailModal');
        if (!modal) return;

        document.getElementById('modalAvatar').textContent = agent.avatar;
        document.getElementById('modalAgentName').textContent = agent.name;
        document.getElementById('modalAgentRole').textContent = agent.role;
        document.getElementById('modalStateVal').textContent = agent.state;
        document.getElementById('modalRoomVal').textContent = `${agent.room} (Desk #${agent.seat})`;
        document.getElementById('modalModelVal').textContent = agent.model;
        document.getElementById('modalCurrentTask').textContent = agent.currentTask;
        document.getElementById('modalRecentActivity').textContent = agent.recentActivity;
        document.getElementById('modalMission').textContent = agent.mission || '';

        const skillsEl = document.getElementById('modalSkills');
        if (skillsEl) {
          skillsEl.innerHTML = (agent.skills || []).map(s => `
            <span class="badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); font-size: 11px;">#${s}</span>
          `).join('');
        }

        modal.style.display = 'flex';
      }

      function closeDossierModal() {
        const modal = document.getElementById('stationDetailModal');
        if (modal) modal.style.display = 'none';
      }

      // --------------------------------------------------------------------------
      // Live Refresh Loop
      // --------------------------------------------------------------------------

      async function refreshAndRender() {
        await fetchLiveOffice();
        renderOffice2D();
        updateClockAndLighting();
      }

      // --------------------------------------------------------------------------
      // Event Bindings & Initialization
      // --------------------------------------------------------------------------
      document.addEventListener('DOMContentLoaded', () => {
        // Render with static fallback immediately (no flash of empty content)
        renderOffice2D();
        updateClockAndLighting();
        updateHudStatus(null);

        // Kick off live fetch — renders again with live data if successful
        refreshAndRender();

        // Clock updates every 5s (cheap, local)
        setInterval(updateClockAndLighting, 5000);

        // Freshness label updates every 5s
        setInterval(updateFreshness, 5000);

        // Live office refresh every 30s (aligned with API expiresAt TTL)
        setInterval(refreshAndRender, REFRESH_INTERVAL_MS);

        document.getElementById('officeNavPrev')?.addEventListener('click', () => {
          switchRoom(currentRoom === 'workspace' ? 'lounge' : 'workspace');
        });
        document.getElementById('officeNavNext')?.addEventListener('click', () => {
          switchRoom(currentRoom === 'workspace' ? 'lounge' : 'workspace');
        });
        document.getElementById('dotWorkspace')?.addEventListener('click', () => switchRoom('workspace'));
        document.getElementById('dotLounge')?.addEventListener('click', () => switchRoom('lounge'));

        document.getElementById('toggleView2D')?.addEventListener('click', () => switchOfficeMode('2D'));
        document.getElementById('toggleView3D')?.addEventListener('click', () => switchOfficeMode('3D'));

        document.getElementById('closeStationModalBtn')?.addEventListener('click', closeDossierModal);
        document.getElementById('stationDetailModal')?.addEventListener('click', (e) => {
          if (e.target.id === 'stationDetailModal') closeDossierModal();
        });

        document.getElementById('refreshOfficeBtn')?.addEventListener('click', () => {
          refreshAndRender();
        });
      });

      // Global hook for inline onclicks
      window.openDossierModal = openDossierModal;
      window.switchOfficeMode = switchOfficeMode;
    </script>

    <style>
      .topbar-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .active-nav {
        font-family: var(--font-mono);
        font-size: 0.9rem;
        color: var(--gray-100);
        font-weight: 600;
      }
      .main-container {
        padding-top: 2rem;
        padding-bottom: 4rem;
        max-width: 1400px;
        margin: 0 auto;
      }
      .office-page-hero {
        border-bottom: 1px solid var(--gray-20);
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
      }
      .meta-status {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: var(--gray-60);
        margin-bottom: 1rem;
      }
      .status-indicator {
        width: 8px;
        height: 8px;
        background: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 8px #10b981;
      }
      .page-title {
        font-family: var(--font-sans);
        font-size: clamp(2rem, 4vw, 2.75rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        margin-bottom: 0.5rem;
      }
      .hero-desc {
        color: var(--gray-60);
        font-size: 1.05rem;
        max-width: 800px;
        line-height: 1.6;
      }

      /* 2-Column Office Layout */
      .virtual-office-layout {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 24px;
        align-items: start;
      }

      @media (max-width: 1080px) {
        .virtual-office-layout {
          grid-template-columns: 1fr;
        }
      }

      .virtual-office-stage-col {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .virtual-office-sidebar {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .office-sidebar-card {
        background: #090e17;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 16px;
      }

      .sidebar-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }

      .sidebar-card-title {
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 700;
        color: #f8fafc;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      /* Roster Chips */
      .agent-chip-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .agent-chip-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .agent-chip-item:hover {
        background: rgba(56, 189, 248, 0.08);
        border-color: rgba(56, 189, 248, 0.3);
