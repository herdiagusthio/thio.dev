---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCta from '../components/ContactCta.astro';
import { EMPTY_PROJECTION, infraCounts, type Projection } from '../lib/infrastructure';

// Generated by scripts/sync-content.mjs and git-ignored; a glob, so a build without it renders an empty page.
const generated = import.meta.glob<Projection>('../../content/infrastructure.json', { eager: true, import: 'default' });
const infra = Object.values(generated)[0] ?? EMPTY_PROJECTION;

const host = infra.host;
const apps = infra.applications;
const internal = infra.internal_services;
const counts = infraCounts(infra);
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
const ports = host?.edge_proxy.public_ports ?? [];
const portList = ports.join(' and ');
const sizing = host
  ? [host.cpu, host.ram_mb && `${host.ram_mb} MB of RAM`, host.swap_mb && `${host.swap_mb} MB of swap`, host.os].filter(Boolean).join(', ')
  : '';
const description = `${plural(counts.publicApps, 'public app')} and ${plural(counts.internalServices, 'internal service')} on one VPS: how requests reach them through Caddy, and what each one stores.`;

// Precompute SVG coordinates for the 4-layer architecture diagram
const rowHeight = 74;
const topPad = 74;
const svgHeight = Math.max(540, topPad + apps.length * rowHeight + 40);
const svgWidth = 1080;
const col1X = 20;
const col1W = 230;
const col2X = 310;
const col2W = 206;
const col3X = 576;
const col3W = 244;
const col4X = 876;
const col4W = 184;
const caddyY = Math.round(svgHeight / 2 - 92);
const caddyH = 184;
const caddyCenterY = caddyY + caddyH / 2;
---

<BaseLayout
  title="Infrastructure: how my apps are hosted — thio.dev"
  description={description}
  canonicalPath="/infrastructure"
  active="infrastructure"
>
  <main id="main" class="wrap main-container">
    <section class="page-hero">
      <div class="meta-status">
        <span class="status-indicator"></span>
        <span class="mono-label">[INFRASTRUCTURE]</span>
      </div>
      <h1 class="page-title">How my apps are hosted</h1>
      <div class="prose">
        <p>
          Everything I run in public sits on one small VPS{sizing && `: ${sizing}`}. This page shows how a request gets from the internet to an app, and what each app stores.
        </p>
        <p>
          It is generated at deploy time from the infrastructure catalog in my notes, so the numbers below come from the same data as the cards.
        </p>
      </div>

      <div class="kpi-strip">
        <div class="kpi-box">
          <span class="kpi-label">[ PUBLIC APPS ]</span>
          <strong class="kpi-val">{counts.publicApps}</strong>
          <span class="kpi-sub">each with a card below</span>
        </div>
        <div class="kpi-box">
          <span class="kpi-label">[ INTERNAL SERVICES ]</span>
          <strong class="kpi-val">{counts.internalServices}</strong>
          <span class="kpi-sub">not publicly routed</span>
        </div>
        <div class="kpi-box">
          <span class="kpi-label">[ PUBLIC HTTPS HOSTS ]</span>
          <strong class="kpi-val">{counts.publicHosts}</strong>
          <span class="kpi-sub">all served through Caddy</span>
        </div>
        <div class="kpi-box">
          <span class="kpi-label">[ DATABASES ]</span>
          <strong class="kpi-val">{counts.databases}</strong>
          <span class="kpi-sub">on the same host as their apps</span>
        </div>
      </div>
    </section>

    <!-- SECTION 1: VISUAL ARCHITECTURE TOPOLOGY DIAGRAM -->
    <section class="content-section">
      <div class="section-header-row">
        <div>
          <h2 class="section-head">01 // Request path</h2>
          <p class="section-sub">
            Public HTTPS host → Caddy → app on 127.0.0.1 → its data.
          </p>
        </div>
      </div>

      <div class="diagram-frame">
        <svg
          viewBox={`0 0 ${svgWidth} ${svgHeight}`}
          width="100%"
          height="auto"
          role="img"
          aria-label={`Diagram: ${plural(counts.publicHosts, 'public HTTPS host')} route through Caddy to ${plural(counts.publicApps, 'public app')} and their databases`}
        >
          <g font-family="monospace" font-size="11" font-weight="700" fill="#94a3b8">
            <text x={col1X + 6} y="30">1. PUBLIC EDGE &amp; DNS</text>
            <text x={col2X + 6} y="30">2. TLS REVERSE PROXY</text>
            <text x={col3X + 6} y="30">3. APPS ON 127.0.0.1</text>
            <text x={col4X + 6} y="30">4. DATA</text>
          </g>
          <line x1="16" y1="42" x2={svgWidth - 16} y2="42" stroke="#1e293b" stroke-width="1" />

          {apps.map((app, idx) => {
            const cy = topPad + idx * rowHeight + 28;
            const x1 = col1X + col1W;
            const x2 = col2X;
            const c1x = Math.round((x1 + x2) / 2);
            const x3 = col2X + col2W;
            const x4 = col3X;
            const c2x = Math.round((x3 + x4) / 2);
            const x5 = col3X + col3W;
            const x6 = col4X;
            const c3x = Math.round((x5 + x6) / 2);
            const isPublicHttps = Boolean(app.public_domain);
            const domainText = (app.public_domain ?? 'Not publicly routed').replace(/^https?:\/\//, '').slice(0, 30);
            const protoText = isPublicHttps ? 'HTTPS' : 'No public host';
            const stackText = (app.tech_stack || []).slice(0, 2).join(' · ').slice(0, 31);
            const primaryDb = app.databases?.[0];
            const dbEngine = primaryDb ? primaryDb.engine.split('(')[0].trim().slice(0, 23) : 'No database listed';
            const appTableCount = app.databases.reduce((s, d) => s + d.table_count, 0);

            return (
              <g>
                <path
                  class={`infra-flow-path infra-path-${app.id}`}
                  data-app={app.id}
                  d={`M ${x1} ${cy} C ${c1x} ${cy}, ${c1x} ${caddyCenterY}, ${x2} ${caddyCenterY}`}
                  fill="none"
                  stroke="#38bdf8"
                  stroke-width="1.5"
                  stroke-opacity="0.55"
                  stroke-dasharray={isPublicHttps ? undefined : '4 4'}
                  style="transition: all 0.25s ease;"
                />
                <path
                  class={`infra-flow-path infra-path-${app.id}`}
                  data-app={app.id}
                  d={`M ${x3} ${caddyCenterY} C ${c2x} ${caddyCenterY}, ${c2x} ${cy}, ${x4} ${cy}`}
                  fill="none"
                  stroke="#38bdf8"
                  stroke-width="1.75"
                  stroke-opacity="0.75"
                  style="transition: all 0.25s ease;"
                />
                <path
                  class={`infra-flow-path infra-path-${app.id}`}
                  data-app={app.id}
                  d={`M ${x5} ${cy} C ${c3x} ${cy}, ${c3x} ${cy}, ${x6} ${cy}`}
                  fill="none"
                  stroke="#a78bfa"
                  stroke-width="1.5"
                  stroke-opacity="0.7"
                  style="transition: all 0.25s ease;"
                />

                {/* Tier 1: Public Route */}
                <g class={`infra-flow-node infra-node-${app.id}`} data-app={app.id} transform={`translate(${col1X}, ${cy - 23})`} style="cursor: pointer;">
                  <rect width={col1W} height="46" rx="6" fill="#0f172a" stroke="#1e293b" stroke-width="1.4" />
                  <circle cx="13" cy="17" r="4" fill={isPublicHttps ? '#10b981' : '#64748b'} />
                  <text x="24" y="20" fill="#e2e8f0" font-family="monospace" font-size="10.5" font-weight="600">
                    {domainText}
                  </text>
                  <text x="13" y="36" fill="#94a3b8" font-family="sans-serif" font-size="9.5">
                    {protoText}
                  </text>
                </g>

                {/* Tier 3: Application */}
                <g class={`infra-flow-node infra-node-${app.id}`} data-app={app.id} transform={`translate(${col3X}, ${cy - 25})`} style="cursor: pointer;">
                  <rect width={col3W} height="50" rx="6" fill="#111827" stroke="#0284c7" stroke-width="1.4" />
                  <circle cx="13" cy="17" r="4" fill="#10b981" />
                  <text x="24" y="20" fill="#f8fafc" font-family="monospace" font-size="11.5" font-weight="700">
                    {app.name}
                  </text>
                  <text x="13" y="38" fill="#94a3b8" font-family="sans-serif" font-size="9.5">
                    {stackText}
                  </text>
                </g>

                {/* Tier 4: Database */}
                <g class={`infra-flow-node infra-node-${app.id}`} data-app={app.id} transform={`translate(${col4X}, ${cy - 23})`} style="cursor: pointer;">
                  <rect width={col4W} height="46" rx="6" fill="#1e1b4b" stroke="#6d28d9" stroke-width="1.3" />
                  <text x="11" y="19" fill="#ddd6fe" font-family="monospace" font-size="10.5" font-weight="700">
                    {dbEngine}
                  </text>
                  <text x="11" y="35" fill="#c4b5fd" font-family="sans-serif" font-size="9.5">
                    {(app.databases || []).length} DB · {plural(appTableCount, 'table')}
                  </text>
                </g>
              </g>
            );
          })}

          {/* Tier 2: Central Caddy TLS Proxy */}
          <g transform={`translate(${col2X}, ${caddyY})`}>
            <rect width={col2W} height={caddyH} rx="10" fill="#0c192c" stroke="#38bdf8" stroke-width="2" />
            <rect x="12" y="14" width={col2W - 24} height="22" rx="4" fill="#0369a1" />
            <text x={col2W / 2} y="29" text-anchor="middle" fill="#ffffff" font-family="monospace" font-size="10.5" font-weight="700">
              CADDY
            </text>
            <text x={col2W / 2} y="56" text-anchor="middle" fill="#e2e8f0" font-family="sans-serif" font-size="10.5" font-weight="600">
              {host?.edge_proxy.name}
            </text>
            <text x={col2W / 2} y="78" text-anchor="middle" fill="#38bdf8" font-family="monospace" font-size="10">
              Ports {ports.map((p) => `:${p}`).join(' / ')} · TLS 1.2 + 1.3
            </text>
            <text x={col2W / 2} y="100" text-anchor="middle" fill="#10b981" font-family="monospace" font-size="10">
              → apps on 127.0.0.1
            </text>
            <text x={col2W / 2} y="122" text-anchor="middle" fill="#cbd5e1" font-family="sans-serif" font-size="9.5">
              HSTS · X-Frame-Options · nosniff
            </text>
          </g>
        </svg>
      </div>
    </section>

    <!-- SECTION 2: HOW THE SERVER COMMUNICATES WITH THE PUBLIC -->
    <section class="content-section">
      <h2 class="section-head">02 // How it is set up</h2>
      <div class="protocol-grid">
        <div class="protocol-card">
          <div class="protocol-step">[ 01 · ONE WAY IN ]</div>
          <h3>Caddy is the only web entry point</h3>
          <p>
            Caddy listens on ports {portList} and terminates HTTPS with TLS 1.2 and 1.3. On the main sites it also sets <code>Strict-Transport-Security</code>, <code>X-Frame-Options</code> and <code>X-Content-Type-Options: nosniff</code>.
          </p>
        </div>
        <div class="protocol-card">
          <div class="protocol-step">[ 02 · BACKENDS ON LOOPBACK ]</div>
          <h3>Apps listen on 127.0.0.1 only</h3>
          <p>
            Every backend binds to <code>127.0.0.1</code>, so the internet reaches it only through a Caddy site. Apart from Caddy, the one port open to the internet is SSH on <code>22</code>.
          </p>
        </div>
        <div class="protocol-card">
          <div class="protocol-step">[ 03 · LOCAL DATA ]</div>
          <h3>Data stays on the same host</h3>
          <p>
            The {plural(counts.databases, 'database')} below live next to their apps and, like them, are not exposed to the internet.
          </p>
        </div>
        <div class="protocol-card">
          <div class="protocol-step">[ 04 · ONE CATALOG ]</div>
          <h3>One catalog, published through an allowlist</h3>
          <p>
            Apps, routes and databases are declared in one catalog in my notes. This page is built from it field by field: public apps get a card, internal services only a name and purpose, and addresses, paths and schemas stay private.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 3: APPLICATIONS, TECH STACKS & DATABASE SCHEMAS -->
    <section class="content-section">
      <div class="search-bar-row">
        <div>
          <h2 class="section-head">03 // Public apps ({counts.publicApps})</h2>
          <p class="section-sub">
            What each app does, what it is built with, where it is served and what it stores. Hover a card or a diagram node to highlight its path.
          </p>
        </div>
        <div class="db-search-box">
          <input
            id="publicDbSearch"
            type="search"
            placeholder="🔍 Search tables or columns (e.g. users, rsvp, transactions)..."
            aria-label="Filter database tables or columns"
          />
          <span id="publicDbSearchBadge" class="search-badge" style="display:none;"></span>
        </div>
      </div>

      <div class="app-list">
        {apps.map((app, index) => (
          <article class="app-card" id={`app-${app.id}`} data-app-id={app.id}>
            <div class="app-card-header">
              <div>
                <div class="app-meta-row">
                  <span class="app-index">APP_0{index + 1}</span>
                  <span class="app-category">{app.category}</span>
                </div>
                <h3 class="app-name">
                  {app.name} <span class="app-title-muted">— {app.title}</span>
                </h3>
              </div>
              {app.public_domain ? (
                <a href={app.public_domain} target="_blank" rel="noopener" class="domain-pill">
                  {app.public_domain.replace(/^https:\/\//, '')} ↗
                </a>
              ) : (
                <span class="domain-pill internal">Not publicly routed</span>
              )}
            </div>

            <p class="app-purpose">{app.purpose}</p>

            <div class="app-two-col">
              <div class="app-box">
                <div class="box-label">[ TECH STACK ]</div>
                <div class="tag-list">
                  {(app.tech_stack || []).map((t) => (
                    <span class="tech-tag">{t}</span>
                  ))}
                </div>
              </div>

              <div class="app-box">
                <div class="box-label">[ PUBLIC HTTPS ROUTES ]</div>
                <div class="route-list">
                  {(app.public_routes || []).map((r) => (
                    <div class="route-row">
                      <code class="route-domain">{r.domain}{r.path}</code>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <div class="db-section">
              <div class="box-label">[ DATA ({app.databases.length}) ]</div>
              {(app.databases || []).map((db) => (
                <div class="db-card">
                  <div class="db-header">
                    <div>
                      <strong class="db-name">{db.name}</strong>
                      <span class="db-engine">{db.engine}</span>
                    </div>
                    <span class="db-count">{db.table_count} table{db.table_count === 1 ? '' : 's'}</span>
                  </div>
                  {db.summary && <p class="db-summary">{db.summary}</p>}
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section" id="internal-services">
      <h2 class="section-head">04 // Internal services ({counts.internalServices})</h2>
      <p class="section-sub">These run on the same host but have no public route.</p>
      <ul class="internal-list">
        {internal.map((svc) => (
          <li>
            <strong>{svc.name}</strong> <span class="app-category">{svc.category}</span>
            <p>{svc.purpose}</p>
          </li>
        ))}
      </ul>
    </section>

    <ContactCta />
  </main>
  <a slot="footer" href="/" class="back-link">[ ← RETURN TO CONSOLE ]</a>
</BaseLayout>

<style>
  .page-hero {
    border-bottom: 1px dashed var(--gray-30);
    padding-bottom: 2rem;
    margin-bottom: 3rem;
  }
  .page-title {
    margin-bottom: 1.25rem;
  }
  .kpi-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }
  @media (max-width: 760px) {
    .kpi-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .kpi-box {
    border: 1px solid var(--gray-20);
    background: rgba(255, 255, 255, 0.015);
    padding: 1rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .kpi-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #38bdf8;
    letter-spacing: 0.04em;
  }
  .kpi-val {
    font-family: var(--font-mono);
    font-size: 1.55rem;
    color: var(--gray-100);
    font-weight: 800;
  }
  .kpi-sub {
    font-size: 0.8rem;
    color: var(--gray-60);
  }
  .content-section {
    margin-bottom: 3.75rem;
  }
  .section-head {
    font-family: var(--font-sans);
    font-size: 1.45rem;
    font-weight: 800;
    margin-bottom: 0.4rem;
    letter-spacing: -0.02em;
    border-bottom: 2px solid var(--gray-20);
    padding-bottom: 0.5rem;
  }
  .section-sub {
    font-size: 0.94rem;
    color: var(--gray-60);
    margin-bottom: 1.5rem;
  }
  .diagram-frame {
    border: 1px solid var(--gray-20);
    background: #090d16;
    border-radius: 8px;
    padding: 0.75rem;
    overflow-x: auto;
  }
  .protocol-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-top: 1.25rem;
  }
  @media (max-width: 720px) {
    .protocol-grid {
      grid-template-columns: 1fr;
    }
  }
  .protocol-card {
    border: 1px solid var(--gray-20);
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.01);
  }
  .protocol-step {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #38bdf8;
    margin-bottom: 0.4rem;
    font-weight: 600;
  }
  .protocol-card h3 {
    font-size: 1.08rem;
    margin-bottom: 0.5rem;
    color: var(--gray-100);
  }
  .protocol-card p {
    font-size: 0.9rem;
    color: var(--gray-70);
    line-height: 1.55;
    margin: 0;
  }
  .app-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .app-card {
    border: 1px solid var(--gray-20);
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.012);
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }
  .app-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--gray-20);
    padding-bottom: 0.9rem;
  }
  .app-meta-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.35rem;
  }
  .app-index {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #10b981;
    font-weight: 700;
  }
  .app-category {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #38bdf8;
  }
  .app-name {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0;
    color: var(--gray-100);
  }
  .app-title-muted {
    font-weight: 400;
    font-size: 1rem;
    color: var(--gray-60);
  }
  .domain-pill {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid #38bdf8;
    color: #38bdf8;
    text-decoration: none;
    white-space: nowrap;
  }
  .domain-pill.internal {
    border-color: var(--gray-30);
    color: var(--gray-60);
  }
  .app-purpose {
    font-size: 0.95rem;
    color: var(--gray-80);
    line-height: 1.6;
    margin: 0;
  }
  .app-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 720px) {
    .app-two-col {
      grid-template-columns: 1fr;
    }
  }
  .app-box {
    border: 1px solid var(--gray-20);
    padding: 0.9rem 1rem;
    background: rgba(0, 0, 0, 0.2);
  }
  .box-label {
    font-family: var(--font-mono);
    font-size: 0.73rem;
    color: var(--gray-50);
    margin-bottom: 0.6rem;
    font-weight: 600;
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .tech-tag {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.2rem 0.55rem;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #e2e8f0;
  }
  .route-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .route-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    flex-wrap: wrap;
  }
  .route-domain {
    color: #38bdf8;
    font-size: 0.78rem;
  }
  .route-proto {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--gray-60);
  }
  .db-section {
    border-top: 1px dashed var(--gray-20);
    padding-top: 1rem;
  }
  .db-card {
    border: 1px solid rgba(139, 92, 246, 0.35);
    background: rgba(30, 27, 75, 0.18);
    padding: 1rem;
    margin-top: 0.6rem;
  }
  .db-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .db-name {
    font-family: var(--font-mono);
    color: #ddd6fe;
    font-size: 0.92rem;
    margin-right: 0.75rem;
  }
  .db-engine {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: #a78bfa;
  }
  .db-count {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #c4b5fd;
  }
  .db-summary {
    font-size: 0.86rem;
    color: var(--gray-70);
    margin: 0.45rem 0 0.75rem 0;
  }
  .table-grid {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .schema-table-card {
    background: rgba(9, 13, 22, 0.75);
    border: 1px solid var(--gray-20);
    padding: 0.65rem 0.85rem;
  }
  .schema-table-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }
  .schema-table-name {
    color: #c4b5fd;
    font-weight: 700;
    font-size: 0.82rem;
  }
  .schema-table-desc {
    font-size: 0.78rem;
    color: var(--gray-60);
  }
  .schema-cols {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .schema-col-pill {
    font-size: 0.73rem;
    padding: 0.12rem 0.45rem;
    background: rgba(30, 41, 59, 0.85);
    border: 1px solid rgba(148, 163, 184, 0.2);
    color: #cbd5e1;
  }
  .search-bar-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .db-search-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
    max-width: 440px;
    min-width: 260px;
    margin-top: 0.5rem;
  }
  .db-search-box input {
    width: 100%;
    padding: 0.55rem 0.9rem;
    font-size: 0.82rem;
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid var(--gray-30);
    color: var(--gray-100);
    border-radius: 4px;
    font-family: var(--font-sans);
  }
  .db-search-box input:focus {
    outline: none;
    border-color: #38bdf8;
  }
  .search-badge {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid #38bdf8;
    color: #38bdf8;
    white-space: nowrap;
    border-radius: 4px;
  }
  .app-card {
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .schema-table-card {
    transition: opacity 0.2s ease;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const svgPaths = document.querySelectorAll('.infra-flow-path');
    const appCards = document.querySelectorAll('.app-card');
    const svgNodes = document.querySelectorAll('.infra-flow-node');

    function highlightApp(appId) {
      if (!appId) {
        svgPaths.forEach((p) => {
          p.style.opacity = '';
          p.style.strokeWidth = '';
          p.style.filter = '';
        });
        appCards.forEach((c) => {
          c.style.borderColor = '';
          c.style.boxShadow = '';
        });
        return;
      }
      svgPaths.forEach((p) => {
        if (p.getAttribute('data-app') === appId) {
          p.style.opacity = '1';
          p.style.strokeWidth = '3.2';
          p.style.filter = 'drop-shadow(0 0 5px rgba(56,189,248,0.85))';
        } else {
          p.style.opacity = '0.12';
          p.style.strokeWidth = '1';
          p.style.filter = 'none';
        }
      });
      appCards.forEach((c) => {
        if (c.getAttribute('data-app-id') === appId) {
          c.style.borderColor = '#38bdf8';
          c.style.boxShadow = '0 0 16px rgba(56,189,248,0.12)';
        } else {
          c.style.borderColor = '';
          c.style.boxShadow = '';
        }
      });
    }

    appCards.forEach((card) => {
      card.addEventListener('mouseenter', () => highlightApp(card.getAttribute('data-app-id')));
      card.addEventListener('mouseleave', () => highlightApp(null));
    });

    svgNodes.forEach((node) => {
      node.addEventListener('mouseenter', () => highlightApp(node.getAttribute('data-app')));
      node.addEventListener('mouseleave', () => highlightApp(null));
    });

    const searchInput = document.getElementById('publicDbSearch');
    const searchBadge = document.getElementById('publicDbSearchBadge');
    searchInput?.addEventListener('input', (e) => {
      const q = e.target.value.trim().toLowerCase();
      const tableCards = document.querySelectorAll('.schema-table-card');
      if (!q) {
        tableCards.forEach((t) => (t.style.display = ''));
        if (searchBadge) searchBadge.style.display = 'none';
        return;
      }
      let count = 0;
      tableCards.forEach((t) => {
        const hit = t.textContent.toLowerCase().includes(q);
        t.style.display = hit ? '' : 'none';
        if (hit) count++;
      });
      if (searchBadge) {
        searchBadge.style.display = 'inline-block';
        searchBadge.textContent = `${count} table${count === 1 ? '' : 's'} matched`;
      }
    });
  });
</script>
