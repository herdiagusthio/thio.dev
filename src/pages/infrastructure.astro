</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const svgPaths = document.querySelectorAll('.infra-flow-path');
    const appCards = document.querySelectorAll('.app-card');
    const svgNodes = document.querySelectorAll('.infra-flow-node');

    function highlightApp(appId) {
      if (!appId) {
        svgPaths.forEach((p) => {
          p.style.opacity = '';
          p.style.strokeWidth = '';
          p.style.filter = '';
        });
        appCards.forEach((c) => {
          c.style.borderColor = '';
          c.style.boxShadow = '';
        });
        return;
      }
      svgPaths.forEach((p) => {
        if (p.getAttribute('data-app') === appId) {
          p.style.opacity = '1';
          p.style.strokeWidth = '3.2';
          p.style.filter = 'drop-shadow(0 0 5px rgba(56,189,248,0.85))';
        } else {
          p.style.opacity = '0.12';
          p.style.strokeWidth = '1';
          p.style.filter = 'none';
        }
      });
      appCards.forEach((c) => {
        if (c.getAttribute('data-app-id') === appId) {
          c.style.borderColor = '#38bdf8';
          c.style.boxShadow = '0 0 16px rgba(56,189,248,0.12)';
        } else {
          c.style.borderColor = '';
          c.style.boxShadow = '';
        }
      });
    }

    appCards.forEach((card) => {
      card.addEventListener('mouseenter', () => highlightApp(card.getAttribute('data-app-id')));
      card.addEventListener('mouseleave', () => highlightApp(null));
    });

    svgNodes.forEach((node) => {
      node.addEventListener('mouseenter', () => highlightApp(node.getAttribute('data-app')));
      node.addEventListener('mouseleave', () => highlightApp(null));
    });

    const searchInput = document.getElementById('publicDbSearch');
    const searchBadge = document.getElementById('publicDbSearchBadge');
    searchInput?.addEventListener('input', (e) => {
      const q = e.target.value.trim().toLowerCase();
      const tableCards = document.querySelectorAll('.schema-table-card');
      if (!q) {
        tableCards.forEach((t) => (t.style.display = ''));
        if (searchBadge) searchBadge.style.display = 'none';
        return;
      }
      let count = 0;
      tableCards.forEach((t) => {
        const hit = t.textContent.toLowerCase().includes(q);
        t.style.display = hit ? '' : 'none';
        if (hit) count++;
      });
      if (searchBadge) {
        searchBadge.style.display = 'inline-block';
        searchBadge.textContent = `${count} table${count === 1 ? '' : 's'} matched`;
      }
    });
  });
</script>
