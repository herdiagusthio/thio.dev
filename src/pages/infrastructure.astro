<script>
  // Highlight an app's path while its diagram node or card is hovered or focused.
  const root = document.querySelector<HTMLElement>('[data-trace-root]');
  if (root) {
    const items = Array.from(root.querySelectorAll('[data-app]'));
    const trace = (target: EventTarget | null) => {
      const id = target instanceof Element ? (target.closest('[data-app]')?.getAttribute('data-app') ?? null) : null;
      root.classList.toggle('is-tracing', id !== null);
      for (const el of items) el.classList.toggle('is-active', el.getAttribute('data-app') === id);
    };
    root.addEventListener('mouseover', (e) => trace(e.target));
    root.addEventListener('mouseleave', () => trace(null));
    root.addEventListener('focusin', (e) => trace(e.target));
    root.addEventListener('focusout', () => trace(null));
  }
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('publicDbSearch');
    const searchBadge = document.getElementById('publicDbSearchBadge');
    searchInput?.addEventListener('input', (e) => {
      const q = e.target.value.trim().toLowerCase();
      const tableCards = document.querySelectorAll('.schema-table-card');
      if (!q) {
        tableCards.forEach((t) => (t.style.display = ''));
        if (searchBadge) searchBadge.style.display = 'none';
        return;
      }
      let count = 0;
      tableCards.forEach((t) => {
        const hit = t.textContent.toLowerCase().includes(q);
        t.style.display = hit ? '' : 'none';
        if (hit) count++;
      });
      if (searchBadge) {
        searchBadge.style.display = 'inline-block';
        searchBadge.textContent = `${count} table${count === 1 ? '' : 's'} matched`;
      }
    });
  });
</script>
