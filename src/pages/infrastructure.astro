---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCta from '../components/ContactCta.astro';
import { appLinks, diagramModel, EMPTY_PROJECTION, infraCounts, plural, type Projection } from '../lib/infrastructure';

// Generated by scripts/sync-content.mjs and git-ignored; a glob, so a build without it renders an empty page.
const generated = import.meta.glob<Projection>('../../content/infrastructure.json', { eager: true, import: 'default' });
const infra = Object.values(generated)[0] ?? EMPTY_PROJECTION;

const host = infra.host;
const apps = infra.applications;
const internal = infra.internal_services;
const counts = infraCounts(infra);
const ports = host?.edge_proxy.public_ports ?? [];
const portList = ports.length ? ports.join(' and ') : '80 and 443';
const updated = /^\d{4}-\d{2}-\d{2}/.test(infra.updated_at ?? '') ? infra.updated_at!.slice(0, 10) : null;
const sizing = host
  ? [host.cpu, host.ram_mb && `${host.ram_mb} MB of RAM`, host.swap_mb && `${host.swap_mb} MB of swap`, host.os].filter(Boolean).join(', ')
  : '';
const description = `${plural(counts.publicApps, 'public app')} and ${plural(counts.internalServices, 'internal service')} on one VPS: how requests reach them through Caddy, and what each one stores.`;

// Diagram geometry, in SVG units. The SVG renders at least W px wide (it scrolls sideways on narrow
// screens), so 12-unit text stays >= 12 px; LABEL_CHARS in src/lib/infrastructure.ts is sized to these
// columns. A 4-unit margin keeps focus outlines inside the scroll box.
const model = diagramModel(infra);
const W = 788;
const COL = { host: { x: 4, w: 236 }, proxy: { x: 270, w: 112 }, app: { x: 412, w: 192 }, data: { x: 628, w: 156 } };
const TOP = 36;
const ROW = 60;
const NODE = 46;
const PROXY_H = 112;
const blockH = Math.max((model.rows.length + (model.internal ? 1 : 0)) * ROW, PROXY_H + 8);
const H = TOP + blockH + 6;
const proxyY = TOP + (blockH - PROXY_H) / 2;
const nodeY = (i: number) => TOP + i * ROW + (ROW - NODE) / 2;
const routedCount = model.rows.filter((r) => r.host).length;
// Paths fan in and out along the proxy's sides instead of meeting at one point.
const fanY = (k: number) => (routedCount < 2 ? proxyY + PROXY_H / 2 : proxyY + 16 + (k * (PROXY_H - 32)) / (routedCount - 1));
let routed = 0;
const rows = model.rows.map((row, i) => ({ ...row, y: nodeY(i), mid: nodeY(i) + NODE / 2, fan: row.host ? fanY(routed++) : 0 }));
const curve = (x1: number, y1: number, x2: number, y2: number) => {
  const cx = (x1 + x2) / 2;
  return `M ${x1} ${y1} C ${cx} ${y1}, ${cx} ${y2}, ${x2} ${y2}`;
};
---

<BaseLayout
  title="Infrastructure: how my apps are hosted — thio.dev"
  description={description}
  canonicalPath="/infrastructure"
  active="infrastructure"
>
  <main id="main" class="wrap main-container" data-trace-root>
    <section class="page-hero">
      <div class="meta-status">
        <span class="status-indicator"></span>
        <span class="mono-label">[INFRASTRUCTURE]</span>
        {updated && <span class="mono-label">[UPDATED {updated}]</span>}
      </div>
      <h1 class="page-title">How my apps are hosted</h1>
      <div class="prose">
        <p>
          The apps below all run on one small VPS{sizing && `: ${sizing}`}. This page shows how a request gets from the internet to an app, and what each app stores.
        </p>
        <p>
          It is generated at deploy time from the infrastructure catalog in my notes, so the counts, the diagram and the cards come from the same data.
        </p>
      </div>
      <dl class="stat-row">
        <div><dt>Public apps</dt><dd>{counts.publicApps}</dd></div>
        <div><dt>Internal services</dt><dd>{counts.internalServices}</dd></div>
        <div><dt>Public HTTPS hosts</dt><dd>{counts.publicHosts}</dd></div>
        <div><dt>Databases</dt><dd>{counts.databases}</dd></div>
      </dl>
    </section>

    <section class="content-section" aria-labelledby="path-title">
      <div class="section-head-row">
        <h2 id="path-title" class="section-head">Request path</h2>
      </div>
      <p class="section-sub">Public HTTPS host, then Caddy, then the app on 127.0.0.1, then its data.</p>
      <figure class="diagram">
        <div class="diagram-scroll">
          <svg class="diagram-svg" viewBox={`0 0 ${W} ${H}`} width={W} height={H} aria-labelledby="diagram-title">
            <title id="diagram-title">
              {`${plural(counts.publicHosts, 'public HTTPS host')} route through Caddy to ${plural(counts.publicApps, 'public app')} and their data; ${plural(counts.internalServices, 'internal service')} with no public route`}
            </title>
            <g class="dg-heading" aria-hidden="true">
              <text x={COL.host.x} y="16">PUBLIC HTTPS HOSTS</text>
              <text x={COL.proxy.x} y="16">PROXY</text>
              <text x={COL.app.x} y="16">APPS</text>
              <text x={COL.data.x} y="16">DATA</text>
            </g>

            {rows.map((row) => (
              <g aria-hidden="true">
                {row.host && <path class="dg-path" data-app={row.id} d={curve(COL.host.x + COL.host.w, row.mid, COL.proxy.x, row.fan)} />}
                {row.host && <path class="dg-path" data-app={row.id} d={curve(COL.proxy.x + COL.proxy.w, row.fan, COL.app.x, row.mid)} />}
                {row.data && <path class="dg-path" data-app={row.id} d={`M ${COL.app.x + COL.app.w} ${row.mid} H ${COL.data.x}`} />}
              </g>
            ))}

            <g class="dg-proxy">
              <rect x={COL.proxy.x} y={proxyY} width={COL.proxy.w} height={PROXY_H} />
              <text class="dg-title" x={COL.proxy.x + COL.proxy.w / 2} y={proxyY + 26} text-anchor="middle">Caddy</text>
              <text class="dg-sub" x={COL.proxy.x + COL.proxy.w / 2} y={proxyY + 50} text-anchor="middle">{ports.map((p) => `:${p}`).join(' · ')}</text>
              <text class="dg-sub" x={COL.proxy.x + COL.proxy.w / 2} y={proxyY + 72} text-anchor="middle">TLS 1.2 + 1.3</text>
              <text class="dg-sub" x={COL.proxy.x + COL.proxy.w / 2} y={proxyY + 94} text-anchor="middle">→ 127.0.0.1</text>
            </g>

            {rows.map((row) => (
              <g>
                {row.host && (
                  <a class="dg-node" href={row.href} data-app={row.id}>
                    <rect x={COL.host.x} y={row.y} width={COL.host.w} height={NODE} />
                    <text class="dg-mono" x={COL.host.x + 12} y={row.y + 19}>{row.host}</text>
                    <text class="dg-sub" x={COL.host.x + 12} y={row.y + 37}>{row.hostNote}</text>
                  </a>
                )}
                <a class="dg-node" href={row.href} data-app={row.id}>
                  <rect x={COL.app.x} y={row.y} width={COL.app.w} height={NODE} />
                  <text class="dg-title" x={COL.app.x + 12} y={row.y + 19}>{row.name}</text>
                  <text class="dg-sub" x={COL.app.x + 12} y={row.y + 37}>{row.stack}</text>
                </a>
                {row.data && (
                  <a class="dg-node" href={row.href} data-app={row.id}>
                    <rect x={COL.data.x} y={row.y} width={COL.data.w} height={NODE} />
                    <text class="dg-strong" x={COL.data.x + 12} y={row.y + 19}>{row.data.label}</text>
                    <text class="dg-sub" x={COL.data.x + 12} y={row.y + 37}>{row.data.note}</text>
                  </a>
                )}
              </g>
            ))}

            {model.internal && (
              <a class="dg-node dg-internal" href={model.internal.href}>
                <rect x={COL.app.x} y={nodeY(rows.length)} width={COL.app.w} height={NODE} />
                <text class="dg-title" x={COL.app.x + 12} y={nodeY(rows.length) + 19}>{model.internal.label}</text>
                <text class="dg-sub" x={COL.app.x + 12} y={nodeY(rows.length) + 37}>{model.internal.note}</text>
              </a>
            )}
          </svg>
        </div>
        <figcaption class="diagram-hint">Each box links to its app below. On a narrow screen the diagram scrolls sideways.</figcaption>
      </figure>
    </section>

    <section class="content-section" aria-labelledby="setup-title">
      <div class="section-head-row">
        <h2 id="setup-title" class="section-head">How it is set up</h2>
      </div>
      <ul class="principles-list">
        <li>
          <h3>One way in</h3>
          <p>Caddy listens on ports {portList} and terminates HTTPS with TLS 1.2 and 1.3. On the main sites it also sets HSTS, X-Frame-Options and X-Content-Type-Options: nosniff.</p>
        </li>
        <li>
          <h3>Backends on loopback</h3>
          <p>Every backend binds to 127.0.0.1, so the internet reaches it only through a Caddy site. Apart from Caddy, the one port open to the internet is SSH on 22.</p>
        </li>
        <li>
          <h3>Data stays local</h3>
          <p>The {plural(counts.databases, 'database')} listed below live on the same host as their apps and, like them, are not exposed to the internet.</p>
        </li>
        <li>
          <h3>One catalog, published through an allowlist</h3>
          <p>Apps, routes and databases are declared in one catalog in my notes. Public apps get a card here, internal services a name and purpose; addresses, paths and schemas stay private.</p>
        </li>
      </ul>
    </section>

    <section class="content-section" aria-labelledby="apps-title">
      <div class="section-head-row">
        <h2 id="apps-title" class="section-head">Public apps ({counts.publicApps})</h2>
      </div>
      {apps.length === 0 && <p class="section-sub">No public apps in this build.</p>}
      <div class="app-list">
        {apps.map((app) => {
          const links = appLinks(app);
          return (
            <article class="app-card" id={`app-${app.id}`} data-app={app.id}>
              <p class="card-kicker">{app.category}</p>
              <h3>{app.name}</h3>
              <p class="app-title">{app.title}</p>
              <p class="app-purpose">{app.purpose}</p>
              <dl class="app-facts">
                {app.tech_stack.length > 0 && (
                  <div>
                    <dt>Stack</dt>
                    <dd>{app.tech_stack.join(', ')}</dd>
                  </div>
                )}
                {links.length > 0 && (
                  <div>
                    <dt>Served at</dt>
                    <dd>
                      <ul class="link-list">
                        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
                      </ul>
                    </dd>
                  </div>
                )}
                {app.databases.length > 0 && (
                  <div>
                    <dt>Data</dt>
                    <dd>
                      <ul class="data-list">
                        {app.databases.map((db) => (
                          <li>
                            <strong>{db.name}</strong>
                            <span class="data-meta">{[db.engine, plural(db.table_count, 'table')].filter(Boolean).join(' · ')}</span>
                            {db.summary && <p>{db.summary}</p>}
                          </li>
                        ))}
                      </ul>
                    </dd>
                  </div>
                )}
              </dl>
            </article>
          );
        })}
      </div>
    </section>

    {internal.length > 0 && (
      <section class="content-section" id="internal-services" aria-labelledby="internal-title">
        <div class="section-head-row">
          <h2 id="internal-title" class="section-head">Internal services ({counts.internalServices})</h2>
        </div>
        <p class="section-sub">These run on the same host with no public route, so only their name and purpose are listed.</p>
        <ul class="internal-list">
          {internal.map((svc) => (
            <li>
              <strong>{svc.name}</strong>
              <span class="card-kicker">{svc.category}</span>
              <p>{svc.purpose}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <ContactCta />
  </main>
  <a slot="footer" href="/" class="back-link">[ ← RETURN TO CONSOLE ]</a>
</BaseLayout>

<style>
  .page-hero {
    border-bottom: 1px dashed var(--gray-30);
    padding-bottom: 2rem;
    margin-bottom: 1rem;
  }
  .stat-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    margin-top: 1.75rem;
  }
  .stat-row dt {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--gray-60);
  }
  .stat-row dd {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--gray-100);
    font-variant-numeric: tabular-nums;
  }
  .content-section {
    margin-top: 3.5rem;
  }
  .section-head-row {
    border-bottom: 1px solid var(--gray-20);
    padding-bottom: 0.65rem;
    margin-bottom: 1.25rem;
  }
  .section-head {
    font-size: 1.35rem;
  }
  .section-sub {
    color: var(--gray-70);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
  .card-kicker {
    color: #38bdf8;
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }
  .diagram-scroll {
    overflow-x: auto;
    border: 1px solid var(--gray-20);
  }
  .diagram-svg {
    display: block;
    width: 100%;
    min-width: 788px;
    height: auto;
  }
  .diagram-hint {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--gray-60);
  }
  .dg-heading text {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    fill: var(--gray-60);
  }
  .dg-node rect,
  .dg-proxy rect {
    fill: var(--gray-10);
    stroke: var(--gray-50);
    stroke-width: 1;
    transition-property: stroke, stroke-width;
    transition-duration: 0.2s;
  }
  .dg-internal rect {
    stroke-dasharray: 4 3;
  }
  .dg-node.is-active rect {
    stroke: #38bdf8;
    stroke-width: 2;
  }
  .dg-node:focus-visible {
    outline-offset: 1px;
  }
  .dg-node:focus-visible rect {
    stroke: var(--gray-100);
    stroke-width: 2;
  }
  .dg-title,
  .dg-mono {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    fill: var(--gray-90);
  }
  .dg-mono {
    font-size: 12px;
  }
  .dg-strong {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    fill: var(--gray-90);
  }
  .dg-sub {
    font-family: var(--font-sans);
    font-size: 12px;
    fill: var(--gray-60);
  }
  .dg-path {
    fill: none;
    stroke: var(--gray-50);
    stroke-width: 1.5;
    transition-property: stroke, stroke-width;
    transition-duration: 0.2s;
  }
  .is-tracing .dg-path {
    stroke: var(--gray-40);
  }
  .is-tracing .dg-path.is-active {
    stroke: #38bdf8;
    stroke-width: 2.5;
  }
  .principles-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    list-style: none;
  }
  .principles-list li {
    border-top: 2px solid #38bdf8;
    padding-top: 0.8rem;
  }
  .principles-list h3 {
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    margin-bottom: 0.4rem;
  }
  .principles-list p {
    color: var(--gray-70);
    line-height: 1.6;
  }
  .app-list {
    display: grid;
    gap: 1rem;
  }
  .app-card {
    border: 1px solid var(--gray-20);
    padding: 1.25rem;
    transition-property: border-color;
    transition-duration: 0.2s;
  }
  .app-card:target {
    border-color: var(--gray-80);
  }
  .app-card.is-active {
    border-color: #38bdf8;
  }
  .app-card h3 {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    margin-top: 0.5rem;
  }
  .app-title {
    color: var(--gray-60);
    margin-bottom: 0.75rem;
  }
  .app-purpose {
    color: var(--gray-80);
    line-height: 1.6;
  }
  .app-facts {
    margin-top: 1rem;
    display: grid;
    gap: 0.85rem;
  }
  .app-facts > div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    border-top: 1px solid var(--gray-20);
    padding-top: 0.85rem;
  }
  .app-facts dt {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--gray-60);
    padding-top: 0.15rem;
  }
  .app-facts dd {
    color: var(--gray-80);
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  .link-list,
  .data-list {
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .link-list a {
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .data-list strong {
    color: var(--gray-100);
    font-weight: 600;
    margin-right: 0.5rem;
  }
  .data-meta {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--gray-60);
  }
  .data-list p {
    color: var(--gray-70);
    margin-top: 0.2rem;
  }
  .internal-list {
    list-style: none;
    border: 1px solid var(--gray-20);
  }
  .internal-list li {
    padding: 0.85rem 1.15rem;
    border-bottom: 1px solid var(--gray-20);
  }
  .internal-list li:last-child {
    border-bottom: none;
  }
  .internal-list strong {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    margin-right: 0.75rem;
  }
  .internal-list p {
    color: var(--gray-70);
    margin-top: 0.25rem;
    line-height: 1.5;
  }
  @media (max-width: 640px) {
    .principles-list {
      grid-template-columns: 1fr;
    }
    .app-facts > div {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>

<script>
  // Highlight an app's path while its diagram node or card is hovered or focused.
  const root = document.querySelector<HTMLElement>('[data-trace-root]');
  if (root) {
    const items = Array.from(root.querySelectorAll('[data-app]'));
    const trace = (target: EventTarget | null) => {
      const id = target instanceof Element ? (target.closest('[data-app]')?.getAttribute('data-app') ?? null) : null;
      root.classList.toggle('is-tracing', id !== null);
      for (const el of items) el.classList.toggle('is-active', el.getAttribute('data-app') === id);
    };
    root.addEventListener('mouseover', (e) => trace(e.target));
    root.addEventListener('mouseleave', () => trace(null));
    root.addEventListener('focusin', (e) => trace(e.target));
    root.addEventListener('focusout', () => trace(null));
  }
</script>

