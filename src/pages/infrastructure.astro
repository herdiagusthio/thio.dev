  .route-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .route-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    flex-wrap: wrap;
  }
  .route-domain {
    color: #38bdf8;
    font-size: 0.78rem;
  }
  .route-proto {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--gray-60);
  }
  .db-section {
    border-top: 1px dashed var(--gray-20);
    padding-top: 1rem;
  }
  .db-card {
    border: 1px solid rgba(139, 92, 246, 0.35);
    background: rgba(30, 27, 75, 0.18);
    padding: 1rem;
    margin-top: 0.6rem;
  }
  .db-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .db-name {
    font-family: var(--font-mono);
    color: #ddd6fe;
    font-size: 0.92rem;
    margin-right: 0.75rem;
  }
  .db-engine {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: #a78bfa;
  }
  .db-count {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #c4b5fd;
  }
  .db-summary {
    font-size: 0.86rem;
    color: var(--gray-70);
    margin: 0.45rem 0 0.75rem 0;
  }
  .table-grid {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
