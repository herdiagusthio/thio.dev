---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCta from '../components/ContactCta.astro';
import { diagramModel, EMPTY_PROJECTION, infraCounts, plural, type Projection } from '../lib/infrastructure';

// Generated by scripts/sync-content.mjs and git-ignored; a glob, so a build without it renders an empty page.
const generated = import.meta.glob<Projection>('../../content/infrastructure.json', { eager: true, import: 'default' });
const infra = Object.values(generated)[0] ?? EMPTY_PROJECTION;

const host = infra.host;
const apps = infra.applications;
const internal = infra.internal_services;
const counts = infraCounts(infra);
const ports = host?.edge_proxy.public_ports ?? [];
const portList = ports.join(' and ');
const sizing = host
  ? [host.cpu, host.ram_mb && `${host.ram_mb} MB of RAM`, host.swap_mb && `${host.swap_mb} MB of swap`, host.os].filter(Boolean).join(', ')
  : '';
const description = `${plural(counts.publicApps, 'public app')} and ${plural(counts.internalServices, 'internal service')} on one VPS: how requests reach them through Caddy, and what each one stores.`;

// Diagram geometry, in SVG units. The SVG renders at least W px wide (it scrolls sideways on narrow
// screens), so 12-unit text stays >= 12 px; LABEL_CHARS in src/lib/infrastructure.ts is sized to these
// columns. A 4-unit margin keeps focus outlines inside the scroll box.
const model = diagramModel(infra);
const W = 788;
const COL = { host: { x: 4, w: 236 }, proxy: { x: 270, w: 112 }, app: { x: 412, w: 192 }, data: { x: 628, w: 156 } };
const TOP = 36;
const ROW = 60;
const NODE = 46;
const PROXY_H = 112;
const blockH = Math.max((model.rows.length + (model.internal ? 1 : 0)) * ROW, PROXY_H + 8);
const H = TOP + blockH + 6;
const proxyY = TOP + (blockH - PROXY_H) / 2;
const nodeY = (i: number) => TOP + i * ROW + (ROW - NODE) / 2;
const routedCount = model.rows.filter((r) => r.host).length;
// Paths fan in and out along the proxy's sides instead of meeting at one point.
const fanY = (k: number) => (routedCount < 2 ? proxyY + PROXY_H / 2 : proxyY + 16 + (k * (PROXY_H - 32)) / (routedCount - 1));
let routed = 0;
const rows = model.rows.map((row, i) => ({ ...row, y: nodeY(i), mid: nodeY(i) + NODE / 2, fan: row.host ? fanY(routed++) : 0 }));
const curve = (x1: number, y1: number, x2: number, y2: number) => {
  const cx = (x1 + x2) / 2;
  return `M ${x1} ${y1} C ${cx} ${y1}, ${cx} ${y2}, ${x2} ${y2}`;
};
---

<BaseLayout
  title="Infrastructure: how my apps are hosted — thio.dev"
  description={description}
  canonicalPath="/infrastructure"
  active="infrastructure"
>
  <main id="main" class="wrap main-container" data-trace-root>
    <section class="page-hero">
      <div class="meta-status">
        <span class="status-indicator"></span>
        <span class="mono-label">[INFRASTRUCTURE]</span>
      </div>
      <h1 class="page-title">How my apps are hosted</h1>
      <div class="prose">
        <p>
          Everything I run in public sits on one small VPS{sizing && `: ${sizing}`}. This page shows how a request gets from the internet to an app, and what each app stores.
        </p>
        <p>
          It is generated at deploy time from the infrastructure catalog in my notes, so the numbers below come from the same data as the cards.
        </p>
      </div>

      <div class="kpi-strip">
        <div class="kpi-box">
          <span class="kpi-label">[ PUBLIC APPS ]</span>
          <strong class="kpi-val">{counts.publicApps}</strong>
          <span class="kpi-sub">each with a card below</span>
        </div>
        <div class="kpi-box">
          <span class="kpi-label">[ INTERNAL SERVICES ]</span>
          <strong class="kpi-val">{counts.internalServices}</strong>
          <span class="kpi-sub">not publicly routed</span>
        </div>
        <div class="kpi-box">
          <span class="kpi-label">[ PUBLIC HTTPS HOSTS ]</span>
          <strong class="kpi-val">{counts.publicHosts}</strong>
          <span class="kpi-sub">all served through Caddy</span>
        </div>
        <div class="kpi-box">
          <span class="kpi-label">[ DATABASES ]</span>
          <strong class="kpi-val">{counts.databases}</strong>
          <span class="kpi-sub">on the same host as their apps</span>
        </div>
      </div>
    </section>

    <!-- SECTION 1: VISUAL ARCHITECTURE TOPOLOGY DIAGRAM -->
    <section class="content-section">
      <div class="section-header-row">
        <div>
          <h2 class="section-head">01 // Request path</h2>
          <p class="section-sub">
            Public HTTPS host → Caddy → app on 127.0.0.1 → its data.
          </p>
        </div>
      </div>

      <figure class="diagram">
        <div class="diagram-scroll">
          <svg class="diagram-svg" viewBox={`0 0 ${W} ${H}`} width={W} height={H} aria-labelledby="diagram-title">
            <title id="diagram-title">
              {`${plural(counts.publicHosts, 'public HTTPS host')} route through Caddy to ${plural(counts.publicApps, 'public app')} and their data; ${plural(counts.internalServices, 'internal service')} with no public route`}
            </title>
            <g class="dg-heading" aria-hidden="true">
              <text x={COL.host.x} y="16">PUBLIC HTTPS HOSTS</text>
              <text x={COL.proxy.x} y="16">PROXY</text>
              <text x={COL.app.x} y="16">APPS</text>
              <text x={COL.data.x} y="16">DATA</text>
            </g>

            {rows.map((row) => (
              <g aria-hidden="true">
                {row.host && <path class="dg-path" data-app={row.id} d={curve(COL.host.x + COL.host.w, row.mid, COL.proxy.x, row.fan)} />}
                {row.host && <path class="dg-path" data-app={row.id} d={curve(COL.proxy.x + COL.proxy.w, row.fan, COL.app.x, row.mid)} />}
                {row.data && <path class="dg-path" data-app={row.id} d={`M ${COL.app.x + COL.app.w} ${row.mid} H ${COL.data.x}`} />}
              </g>
            ))}

            <g class="dg-proxy">
              <rect x={COL.proxy.x} y={proxyY} width={COL.proxy.w} height={PROXY_H} />
              <text class="dg-title" x={COL.proxy.x + COL.proxy.w / 2} y={proxyY + 26} text-anchor="middle">Caddy</text>
              <text class="dg-sub" x={COL.proxy.x + COL.proxy.w / 2} y={proxyY + 50} text-anchor="middle">{ports.map((p) => `:${p}`).join(' · ')}</text>
              <text class="dg-sub" x={COL.proxy.x + COL.proxy.w / 2} y={proxyY + 72} text-anchor="middle">TLS 1.2 + 1.3</text>
              <text class="dg-sub" x={COL.proxy.x + COL.proxy.w / 2} y={proxyY + 94} text-anchor="middle">→ 127.0.0.1</text>
            </g>

            {rows.map((row) => (
              <g>
                {row.host && (
                  <a class="dg-node" href={row.href} data-app={row.id}>
                    <rect x={COL.host.x} y={row.y} width={COL.host.w} height={NODE} />
                    <text class="dg-mono" x={COL.host.x + 12} y={row.y + 19}>{row.host}</text>
                    <text class="dg-sub" x={COL.host.x + 12} y={row.y + 37}>{row.hostNote}</text>
                  </a>
                )}
                <a class="dg-node" href={row.href} data-app={row.id}>
                  <rect x={COL.app.x} y={row.y} width={COL.app.w} height={NODE} />
                  <text class="dg-title" x={COL.app.x + 12} y={row.y + 19}>{row.name}</text>
                  <text class="dg-sub" x={COL.app.x + 12} y={row.y + 37}>{row.stack}</text>
                </a>
                {row.data && (
                  <a class="dg-node" href={row.href} data-app={row.id}>
                    <rect x={COL.data.x} y={row.y} width={COL.data.w} height={NODE} />
                    <text class="dg-strong" x={COL.data.x + 12} y={row.y + 19}>{row.data.label}</text>
                    <text class="dg-sub" x={COL.data.x + 12} y={row.y + 37}>{row.data.note}</text>
                  </a>
                )}
              </g>
            ))}

            {model.internal && (
              <a class="dg-node dg-internal" href={model.internal.href}>
                <rect x={COL.app.x} y={nodeY(rows.length)} width={COL.app.w} height={NODE} />
                <text class="dg-title" x={COL.app.x + 12} y={nodeY(rows.length) + 19}>{model.internal.label}</text>
                <text class="dg-sub" x={COL.app.x + 12} y={nodeY(rows.length) + 37}>{model.internal.note}</text>
              </a>
            )}
          </svg>
        </div>
        <figcaption class="diagram-hint">Each box links to its app below. On a narrow screen the diagram scrolls sideways.</figcaption>
      </figure>
    </section>

    <!-- SECTION 2: HOW THE SERVER COMMUNICATES WITH THE PUBLIC -->
    <section class="content-section">
      <h2 class="section-head">02 // How it is set up</h2>
      <div class="protocol-grid">
        <div class="protocol-card">
          <div class="protocol-step">[ 01 · ONE WAY IN ]</div>
          <h3>Caddy is the only web entry point</h3>
          <p>
            Caddy listens on ports {portList} and terminates HTTPS with TLS 1.2 and 1.3. On the main sites it also sets <code>Strict-Transport-Security</code>, <code>X-Frame-Options</code> and <code>X-Content-Type-Options: nosniff</code>.
          </p>
        </div>
        <div class="protocol-card">
          <div class="protocol-step">[ 02 · BACKENDS ON LOOPBACK ]</div>
          <h3>Apps listen on 127.0.0.1 only</h3>
          <p>
            Every backend binds to <code>127.0.0.1</code>, so the internet reaches it only through a Caddy site. Apart from Caddy, the one port open to the internet is SSH on <code>22</code>.
          </p>
        </div>
        <div class="protocol-card">
          <div class="protocol-step">[ 03 · LOCAL DATA ]</div>
          <h3>Data stays on the same host</h3>
          <p>
            The {plural(counts.databases, 'database')} below live next to their apps and, like them, are not exposed to the internet.
          </p>
        </div>
        <div class="protocol-card">
          <div class="protocol-step">[ 04 · ONE CATALOG ]</div>
          <h3>One catalog, published through an allowlist</h3>
          <p>
            Apps, routes and databases are declared in one catalog in my notes. This page is built from it field by field: public apps get a card, internal services only a name and purpose, and addresses, paths and schemas stay private.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 3: APPLICATIONS, TECH STACKS & DATABASE SCHEMAS -->
    <section class="content-section">
      <div class="search-bar-row">
        <div>
          <h2 class="section-head">03 // Public apps ({counts.publicApps})</h2>
          <p class="section-sub">
            What each app does, what it is built with, where it is served and what it stores.
          </p>
        </div>
        <div class="db-search-box">
          <input
            id="publicDbSearch"
            type="search"
            placeholder="🔍 Search tables or columns (e.g. users, rsvp, transactions)..."
            aria-label="Filter database tables or columns"
          />
          <span id="publicDbSearchBadge" class="search-badge" style="display:none;"></span>
        </div>
      </div>

      <div class="app-list">
        {apps.map((app, index) => (
          <article class="app-card" id={`app-${app.id}`} data-app={app.id}>
            <div class="app-card-header">
              <div>
                <div class="app-meta-row">
                  <span class="app-index">APP_0{index + 1}</span>
                  <span class="app-category">{app.category}</span>
                </div>
                <h3 class="app-name">
                  {app.name} <span class="app-title-muted">— {app.title}</span>
                </h3>
              </div>
              {app.public_domain ? (
                <a href={app.public_domain} target="_blank" rel="noopener" class="domain-pill">
                  {app.public_domain.replace(/^https:\/\//, '')} ↗
                </a>
              ) : (
                <span class="domain-pill internal">Not publicly routed</span>
              )}
            </div>

            <p class="app-purpose">{app.purpose}</p>

            <div class="app-two-col">
              <div class="app-box">
                <div class="box-label">[ TECH STACK ]</div>
                <div class="tag-list">
                  {(app.tech_stack || []).map((t) => (
                    <span class="tech-tag">{t}</span>
                  ))}
                </div>
              </div>

              <div class="app-box">
                <div class="box-label">[ PUBLIC HTTPS ROUTES ]</div>
                <div class="route-list">
                  {(app.public_routes || []).map((r) => (
                    <div class="route-row">
                      <code class="route-domain">{r.domain}{r.path}</code>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <div class="db-section">
              <div class="box-label">[ DATA ({app.databases.length}) ]</div>
              {(app.databases || []).map((db) => (
                <div class="db-card">
                  <div class="db-header">
                    <div>
                      <strong class="db-name">{db.name}</strong>
                      <span class="db-engine">{db.engine}</span>
                    </div>
                    <span class="db-count">{db.table_count} table{db.table_count === 1 ? '' : 's'}</span>
                  </div>
                  {db.summary && <p class="db-summary">{db.summary}</p>}
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section" id="internal-services">
      <h2 class="section-head">04 // Internal services ({counts.internalServices})</h2>
      <p class="section-sub">These run on the same host but have no public route.</p>
      <ul class="internal-list">
        {internal.map((svc) => (
          <li>
            <strong>{svc.name}</strong> <span class="app-category">{svc.category}</span>
            <p>{svc.purpose}</p>
          </li>
        ))}
      </ul>
    </section>

    <ContactCta />
  </main>
  <a slot="footer" href="/" class="back-link">[ ← RETURN TO CONSOLE ]</a>
</BaseLayout>

<style>
  .page-hero {
    border-bottom: 1px dashed var(--gray-30);
    padding-bottom: 2rem;
    margin-bottom: 3rem;
  }
  .page-title {
    margin-bottom: 1.25rem;
  }
  .kpi-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }
  @media (max-width: 760px) {
    .kpi-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .kpi-box {
    border: 1px solid var(--gray-20);
    background: rgba(255, 255, 255, 0.015);
    padding: 1rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .kpi-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #38bdf8;
    letter-spacing: 0.04em;
  }
  .kpi-val {
    font-family: var(--font-mono);
    font-size: 1.55rem;
    color: var(--gray-100);
    font-weight: 800;
  }
  .kpi-sub {
    font-size: 0.8rem;
    color: var(--gray-60);
  }
  .content-section {
    margin-bottom: 3.75rem;
  }
  .section-head {
    font-family: var(--font-sans);
    font-size: 1.45rem;
    font-weight: 800;
    margin-bottom: 0.4rem;
    letter-spacing: -0.02em;
    border-bottom: 2px solid var(--gray-20);
    padding-bottom: 0.5rem;
  }
  .section-sub {
    font-size: 0.94rem;
    color: var(--gray-60);
    margin-bottom: 1.5rem;
  }
  .diagram-scroll {
    overflow-x: auto;
    border: 1px solid var(--gray-20);
  }
  .diagram-svg {
    display: block;
    width: 100%;
    min-width: 788px;
    height: auto;
  }
  .diagram-hint {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--gray-60);
  }
  .dg-heading text {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    fill: var(--gray-60);
  }
  .dg-node rect,
  .dg-proxy rect {
    fill: var(--gray-10);
    stroke: var(--gray-50);
    stroke-width: 1;
    transition-property: stroke, stroke-width;
    transition-duration: 0.2s;
  }
  .dg-internal rect {
    stroke-dasharray: 4 3;
  }
  .dg-node.is-active rect {
    stroke: #38bdf8;
    stroke-width: 2;
  }
  .dg-node:focus-visible {
    outline-offset: 1px;
  }
  .dg-node:focus-visible rect {
    stroke: var(--gray-100);
    stroke-width: 2;
  }
  .dg-title,
  .dg-mono {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    fill: var(--gray-90);
  }
  .dg-mono {
    font-size: 12px;
  }
  .dg-strong {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    fill: var(--gray-90);
  }
  .dg-sub {
    font-family: var(--font-sans);
    font-size: 12px;
    fill: var(--gray-60);
  }
  .dg-path {
    fill: none;
    stroke: var(--gray-50);
    stroke-width: 1.5;
    transition-property: stroke, stroke-width;
    transition-duration: 0.2s;
  }
  .is-tracing .dg-path {
    stroke: var(--gray-40);
  }
  .is-tracing .dg-path.is-active {
    stroke: #38bdf8;
    stroke-width: 2.5;
  }
  .protocol-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-top: 1.25rem;
  }
  @media (max-width: 720px) {
    .protocol-grid {
      grid-template-columns: 1fr;
    }
  }
  .protocol-card {
    border: 1px solid var(--gray-20);
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.01);
  }
  .protocol-step {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #38bdf8;
    margin-bottom: 0.4rem;
    font-weight: 600;
  }
  .protocol-card h3 {
    font-size: 1.08rem;
    margin-bottom: 0.5rem;
    color: var(--gray-100);
  }
  .protocol-card p {
    font-size: 0.9rem;
    color: var(--gray-70);
    line-height: 1.55;
    margin: 0;
  }
  .app-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .app-card {
    border: 1px solid var(--gray-20);
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.012);
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }
  .app-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--gray-20);
    padding-bottom: 0.9rem;
  }
  .app-meta-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.35rem;
  }
  .app-index {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #10b981;
    font-weight: 700;
  }
  .app-category {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #38bdf8;
  }
  .app-name {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0;
    color: var(--gray-100);
  }
  .app-title-muted {
    font-weight: 400;
    font-size: 1rem;
    color: var(--gray-60);
  }
  .domain-pill {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid #38bdf8;
    color: #38bdf8;
    text-decoration: none;
    white-space: nowrap;
  }
  .domain-pill.internal {
    border-color: var(--gray-30);
    color: var(--gray-60);
  }
  .app-purpose {
    font-size: 0.95rem;
    color: var(--gray-80);
    line-height: 1.6;
    margin: 0;
  }
  .app-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 720px) {
    .app-two-col {
      grid-template-columns: 1fr;
    }
  }
  .app-box {
    border: 1px solid var(--gray-20);
    padding: 0.9rem 1rem;
    background: rgba(0, 0, 0, 0.2);
  }
  .box-label {
