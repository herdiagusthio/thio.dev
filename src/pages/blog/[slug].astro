---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getEntries } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getEntries('blog');
  return posts.map((post, idx) => ({
    params: { slug: post.slug },
    props: {
      post,
      prev: idx < posts.length - 1 ? { title: posts[idx + 1].title, url: `/blog/${posts[idx + 1].slug}`, label: 'ESSAY' } : null,
      next: idx > 0 ? { title: posts[idx - 1].title, url: `/blog/${posts[idx - 1].slug}`, label: 'ESSAY' } : null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post.entry);
---
<ArticleLayout
  item={post}
  active="blog"
  seoTitle={`${post.title} — Herdi Agusthio`}
  canonicalPath={`/blog/${post.slug}`}
  schemaType="BlogPosting"
  eyebrow="ESSAY"
  statusLabel="PUBLISHED"
  back={{ href: '/blog', label: '[ ← RETURN TO BLOG ]' }}
  prev={prev}
  next={next}
>
  <Content />
</ArticleLayout>
