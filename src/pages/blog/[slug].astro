---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getBlogPosts } from '../../lib/feed';

export async function getStaticPaths() {
  const posts = getBlogPosts();
  return posts.map((post, idx) => ({
    params: { slug: post.slug },
    props: {
      post,
      prev: idx < posts.length - 1 ? { title: posts[idx + 1].title, url: `/blog/${posts[idx + 1].slug}`, label: 'ESSAY' } : null,
      next: idx > 0 ? { title: posts[idx - 1].title, url: `/blog/${posts[idx - 1].slug}`, label: 'ESSAY' } : null,
    },
  }));
}

const { post, prev, next } = Astro.props;
---
<ArticleLayout
  item={post}
  active="blog"
  seoTitle={`${post.title} — Herdi Agusthio`}
  canonicalPath={`/blog/${post.slug}`}
  schemaType="BlogPosting"
  eyebrow="ESSAY"
  statusLabel="PUBLISHED"
  back={{ href: '/blog', label: '[ ← RETURN TO BLOG ]' }}
  prev={prev}
  next={next}
>
  <Fragment set:html={post.bodyHtml} />
</ArticleLayout>
