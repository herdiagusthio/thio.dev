---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntries } from '../../lib/content';

const items = await getEntries('blog');
const allTags = Array.from(new Set(items.flatMap((i) => i.tags))).slice(0, 12);
---
<BaseLayout
  title="Engineering Blog & Reflections — Herdi Agusthio (thio.dev)"
  description="Long-form essays, production post-mortems, and reflections on software engineering craftsmanship, distributed Go systems, and autonomous AI agent organizations."
  canonicalPath="/blog"
  schemaType="WebSite"
  active="blog"
>
  <main class="wrap main-container" data-filter-root>
    <section class="blog-hero">
      <div class="meta-status">
        <span class="status-indicator"></span>
        <span class="mono-label">[SYS_BLOG: ESSAYS &amp; PERSPECTIVES]</span>
        <span class="mono-label" data-filter-count>[COUNT:{items.length}]</span>
      </div>
      <h1 class="page-title">Engineering Blog &amp; Reflections</h1>
      <p class="hero-desc">
        Long-form essays, career reflections, and hands-on system deep-dives on software craftsmanship, distributed architectures, and building in the autonomous AI era.
      </p>

      <!-- Search & Tag Filter Bar -->
      <div class="filter-bar">
        <input
          type="search"
          class="search-input"
          placeholder="Search essays by title, summary, or #tag..."
          aria-label="Search blog essays"
          data-filter-input
        />
        <div class="tag-chips">
          <button type="button" class="chip-btn active" data-filter-chip="all">All ({items.length})</button>
          {allTags.map((tag) => (
            <button type="button" class="chip-btn" data-filter-chip={tag}>#{tag}</button>
          ))}
        </div>
      </div>
    </section>

    <div class="blog-grid">
      {items.map((item) => (
        <article
          class="blog-card"
          data-filter-card
          data-title={item.title.toLowerCase()}
          data-summary={item.summaryText.toLowerCase()}
          data-tags={item.tags.join(',').toLowerCase()}
        >
          <div>
            <div class="card-header">
              <span class="card-date">[{item.date}]</span>
              <span class="card-reading">⏱ {item.readingTimeMinutes} min read</span>
              <span class="card-badge">[ESSAY]</span>
            </div>
            <h2 class="card-title">
              <a href={`/blog/${item.slug}`} class="title-link">{item.title}</a>
            </h2>
            <p class="card-summary">{item.summaryText}</p>
          </div>
          <div class="card-footer">
            <div class="card-tags">
              {item.tags.map((tag) => (
                <span class="tag-item">#{tag}</span>
              ))}
            </div>
            <a href={`/blog/${item.slug}`} class="exec-link">[ READ ESSAY → ]</a>
          </div>
        </article>
      ))}
    </div>
  </main>
  <a slot="footer" href="/" class="back-link">[ ← RETURN TO CONSOLE ]</a>
</BaseLayout>

<script>
  import '../../scripts/filter';
</script>

<style>
  .blog-hero {
    border-bottom: 1px solid var(--gray-20);
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }
  .hero-desc {
    font-family: var(--font-sans);
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--gray-70);
    max-width: 48rem;
    margin-bottom: 1.5rem;
  }
  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
    gap: 1.75rem;
  }
  .blog-card {
    background: var(--gray-0);
    border: 1px solid var(--gray-20);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.2s, background 0.2s;
  }
  .blog-card:hover {
    border-color: var(--gray-60);
    background: var(--gray-10);
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--gray-50);
    margin-bottom: 0.9rem;
    gap: 0.5rem;
  }
  .card-reading {
    color: #38bdf8;
  }
  .card-title {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }
  .title-link {
    color: var(--gray-100);
    text-decoration: none;
  }
  .title-link:hover {
    text-decoration: underline;
  }
  .card-summary {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--gray-70);
    margin-bottom: 1.5rem;
  }
  .card-footer {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    border-top: 1px dashed var(--gray-20);
    padding-top: 1rem;
  }
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--gray-60);
  }
  .exec-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--gray-100);
    text-decoration: none;
    font-weight: 600;
    align-self: flex-start;
  }
  .exec-link:hover {
    text-decoration: underline;
  }
</style>
