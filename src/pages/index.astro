---
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import { getFeed } from '../lib/feed';

const allFeed = getFeed();
const showcaseItems = allFeed.filter(f => f.kind === 'engineering' || f.kind === 'decision').slice(0, 3);
const blogItems = allFeed.filter(f => f.kind === 'blog').slice(0, 3);

const year = 2026;
const faviconHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Herdi Agusthio — Software Engineer</title>
    <meta
      name="description"
      content="Software Engineer specializing in high-concurrency Go systems, distributed architecture, and autonomous multi-agent engineering organizations."
    />
    <link rel="icon" href={faviconHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap">
        <span class="brand">thio.dev</span>
        <nav class="nav-links">
          <a href="/showcase">Showcase</a>
          <a href="/office">Office</a>
          <a href="/blog">Blog</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <Hero />

      <div class="layout-main">
        <div class="content-column">
          <!-- Featured Case Files -->
          <section class="content-section">
            <h2 class="section-head">Featured Case Files</h2>
            <div class="card-list">
              {showcaseItems.map(item => (
                <article class="feature-card">
                  <div class="card-meta">
                    <span class="mono-bracket">[{item.date}]</span>
                    {item.tags.slice(0,2).map(tag => (
                      <span class="mono-bracket tag">#{tag}</span>
                    ))}
                  </div>
                  <h3 class="card-title">
                    <a href={item.url}>{item.title}</a>
                  </h3>
                  <div class="card-summary" set:html={item.summaryHtml} />
                  <a href={item.url} class="card-link">[ READ CASE FILE → ]</a>
                </article>
              ))}
            </div>
            <a href="/showcase" class="view-all-link">View all case studies →</a>
          </section>

          <!-- Latest Reflections -->
          <section class="content-section" style="margin-top: 4rem;">
            <h2 class="section-head">Latest Reflections</h2>
            <div class="card-list">
              {blogItems.map(item => (
                <article class="feature-card">
                  <div class="card-meta">
                    <span class="mono-bracket">[{item.date}]</span>
                    <span class="mono-bracket tag">#blog</span>
                  </div>
                  <h3 class="card-title">
                    <a href={item.url}>{item.title}</a>
                  </h3>
                  <div class="card-summary" set:html={item.summaryHtml} />
                  <a href={item.url} class="card-link">[ READ POST → ]</a>
                </article>
              ))}
            </div>
            <a href="/blog" class="view-all-link">View all blog posts →</a>
          </section>
        </div>
      </div>
    </main>

    <footer class="foot wrap">
      <span>© {year} Herdi Agusthio</span>
      <span>Built with Astro</span>
    </footer>

    <style>
      .layout-main {
        max-width: 100%;
        margin-top: 2rem;
      }
      .section-head {
        font-family: var(--font-sans);
        font-size: 1.5rem;
        font-weight: 800;
        margin-bottom: 1.5rem;
        letter-spacing: -0.02em;
        border-bottom: 2px solid var(--gray-20);
        padding-bottom: 0.5rem;
      }
      
      .card-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
      }

      .feature-card {
        background: var(--gray-0);
        border: 1px solid var(--gray-20);
        padding: 1.5rem;
        transition: border-color 0.2s, background 0.2s;
      }
      .feature-card:hover {
        border-color: var(--gray-60);
        background: var(--gray-10);
      }
      
      .card-meta {
        display: flex;
        gap: 0.75rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--gray-50);
        margin-bottom: 0.75rem;
      }
      .tag { color: var(--gray-60); }
      
      .card-title {
        font-family: var(--font-sans);
        font-size: 1.25rem;
        font-weight: 700;
        line-height: 1.3;
        margin-bottom: 0.75rem;
      }
      .card-title a {
        color: var(--gray-100);
        text-decoration: none;
      }
      .card-title a:hover {
        text-decoration: underline;
      }
      
      .card-summary {
        font-family: var(--font-sans);
        font-size: 0.95rem;
        color: var(--gray-70);
        line-height: 1.6;
        margin-bottom: 1.25rem;
      }
      
      .card-link {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: var(--gray-100);
        text-decoration: none;
        font-weight: 600;
      }
      .card-link:hover {
        text-decoration: underline;
      }
      
      .view-all-link {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--gray-80);
        text-decoration: none;
      }
      .view-all-link:hover {
        color: var(--gray-100);
        text-decoration: underline;
      }
    </style>
  </body>
</html>