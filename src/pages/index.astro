---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import Topbar from '../components/Topbar.astro';
import Hero from '../components/Hero.astro';
import { getBlogPosts, getEngineeringShowcases, getDecisions } from '../lib/feed';

const blogItems = getBlogPosts().slice(0, 4);
const showcaseItems = getEngineeringShowcases().slice(0, 3);
const decisionItems = getDecisions().slice(0, 4);

const year = 2026;
---
<!doctype html>
<html lang="en">
  <head>
    <SeoHead
      title="Herdi Agusthio — Software Engineer & Systems Architect"
      description="Software Engineer at Flip specializing in high-concurrency Go systems, distributed architecture, and autonomous multi-agent engineering organizations."
      canonicalPath="/"
      schemaType="WebSite"
    />
  </head>
  <body>
    <Topbar active="home" />

    <main class="wrap">
      <Hero />

      <div class="layout-main">
        <div class="content-column">
          <!-- Latest Engineering Essays & Reflections -->
          <section class="content-section">
            <div class="section-head-row">
              <h2 class="section-head">Latest Engineering Reflections</h2>
              <a href="/blog" class="view-all-link">View all essays ({getBlogPosts().length}) →</a>
            </div>
            <div class="card-list">
              {blogItems.map(item => (
                <article class="feature-card">
                  <div class="card-meta">
                    <span class="mono-bracket">[{item.date}]</span>
                    <span class="mono-bracket reading-badge">⏱ {item.readingTimeMinutes} min read</span>
                    {item.tags.slice(0, 3).map(tag => (
                      <span class="mono-bracket tag">#{tag}</span>
                    ))}
                  </div>
                  <h3 class="card-title">
                    <a href={item.url}>{item.title}</a>
                  </h3>
                  <div class="card-summary" set:html={item.summaryHtml} />
                  <a href={item.url} class="card-link">[ READ ESSAY → ]</a>
                </article>
              ))}
            </div>
          </section>

          <!-- Featured Case Files -->
          <section class="content-section" style="margin-top: 3.5rem;">
            <div class="section-head-row">
              <h2 class="section-head">Featured Production Case Studies</h2>
              <a href="/showcase" class="view-all-link">View all case studies ({getEngineeringShowcases().length}) →</a>
            </div>
            <div class="card-list">
              {showcaseItems.map(item => (
                <article class="feature-card">
                  <div class="card-meta">
                    <span class="mono-bracket">[{item.date}]</span>
                    <span class="mono-bracket reading-badge">⏱ {item.readingTimeMinutes} min read</span>
                    {item.tags.slice(0, 2).map(tag => (
                      <span class="mono-bracket tag">#{tag}</span>
                    ))}
                  </div>
                  <h3 class="card-title">
                    <a href={item.url}>{item.title}</a>
                  </h3>
                  <div class="card-summary" set:html={item.summaryHtml} />
                  <a href={item.url} class="card-link">[ READ CASE FILE → ]</a>
                </article>
              ))}
            </div>
          </section>

          <!-- Recent Architecture Decision Records (ADRs) -->
          <section class="content-section" style="margin-top: 3.5rem;">
            <div class="section-head-row">
              <h2 class="section-head">Recent Architecture Decisions (ADRs)</h2>
              <a href="/showcase#adrs" class="view-all-link">Browse all ADRs ({getDecisions().length}) →</a>
            </div>
            <div class="adr-compact-list">
              {decisionItems.map(adr => (
                <a href={adr.url} class="adr-compact-row">
                  <div class="adr-left">
                    <span class="adr-date">[{adr.date}]</span>
                    <strong class="adr-title">{adr.title}</strong>
                  </div>
                  <span class="adr-status">[ACCEPTED →]</span>
                </a>
              ))}
            </div>
          </section>
        </div>
      </div>
    </main>

    <footer class="foot wrap">
      <span>© {year} Herdi Agusthio · Software Engineer</span>
      <span>Built with Astro 7 · Zero-JS Static Console</span>
    </footer>

    <style>
      .layout-main {
        max-width: 100%;
        margin-top: 2rem;
      }
      .section-head-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        border-bottom: 2px solid var(--gray-20);
        padding-bottom: 0.6rem;
        margin-bottom: 1.5rem;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .section-head {
        font-family: var(--font-sans);
        font-size: 1.45rem;
        font-weight: 800;
        letter-spacing: -0.02em;
      }
      .card-list {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }
      .feature-card {
        background: var(--gray-0);
        border: 1px solid var(--gray-20);
        padding: 1.5rem;
        transition: border-color 0.2s, background 0.2s;
      }
      .feature-card:hover {
        border-color: var(--gray-60);
        background: var(--gray-10);
      }
      .card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--gray-50);
        margin-bottom: 0.75rem;
      }
      .reading-badge {
        color: #38bdf8;
      }
      .tag { color: var(--gray-60); }
      .card-title {
        font-family: var(--font-sans);
        font-size: 1.25rem;
        font-weight: 700;
        line-height: 1.35;
        margin-bottom: 0.65rem;
      }
      .card-title a {
        color: var(--gray-100);
        text-decoration: none;
      }
      .card-title a:hover {
        text-decoration: underline;
      }
      .card-summary {
        font-family: var(--font-sans);
        font-size: 0.96rem;
        color: var(--gray-70);
        line-height: 1.6;
        margin-bottom: 1.1rem;
      }
      .card-link {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        color: var(--gray-100);
        text-decoration: none;
        font-weight: 600;
      }
      .card-link:hover {
        text-decoration: underline;
      }
      .view-all-link {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: var(--gray-70);
        text-decoration: none;
      }
      .view-all-link:hover {
        color: var(--gray-100);
        text-decoration: underline;
      }
      .adr-compact-list {
        display: flex;
        flex-direction: column;
        border: 1px solid var(--gray-20);
      }
      .adr-compact-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--gray-20);
        text-decoration: none;
        transition: background 0.15s;
      }
      .adr-compact-row:last-child {
        border-bottom: none;
      }
      .adr-compact-row:hover {
        background: var(--gray-10);
      }
      .adr-left {
        display: flex;
        align-items: baseline;
        gap: 0.85rem;
        flex-wrap: wrap;
      }
      .adr-date {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--gray-50);
      }
      .adr-title {
        font-family: var(--font-sans);
        font-size: 1rem;
        color: var(--gray-100);
      }
      .adr-status {
        font-family: var(--font-mono);
        font-size: 0.74rem;
        color: #10b981;
        white-space: nowrap;
      }
    </style>
  </body>
</html>