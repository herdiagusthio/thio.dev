---
import '../styles/global.css';
import FeedEntry from '../components/FeedEntry.astro';
import Hero from '../components/Hero.astro';
import { getFeed } from '../lib/feed';

const feed = getFeed();
const allTags = Array.from(new Set(feed.flatMap((f) => f.tags || []))).sort();
const year = 2026;
const faviconHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Herdi Agusthio — Senior Software Engineer</title>
    <meta
      name="description"
      content="Senior Software Engineer focusing on high-leverage distributed systems and engineering excellence."
    />
    <link rel="icon" href={faviconHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap">
        <span class="brand">thio.dev</span>
        <nav class="nav-links">
          <a href="#writing">Archive</a>
          <a href="https://github.com/thiohermes">GitHub</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <Hero />

      <div class="layout-main-grid">
        <div class="feed-column">
          <h2 class="section-head" id="writing">
            Knowledge Archive · {feed.length}
          </h2>

          <div class="feed-filters">
            <span class="mono-bracket">[FILTER:</span>
            <button class="filter-btn active" data-filter="all">ALL</button>
            {allTags.map(tag => (
              <button class="filter-btn" data-filter={tag}>{tag.toUpperCase()}</button>
            ))}
            <span class="mono-bracket">]</span>
          </div>

          <section class="feed">
            {feed.length === 0 ? (
              <p class="empty">No entries yet.</p>
            ) : (
              feed.map((entry) => <FeedEntry entry={entry} />)
            )}
          </section>
        </div>

        <aside class="sidebar context">
          <div class="context-panel">
            <h3 class="mono-bracket">/ System Telemetry</h3>
            <p class="text-sm">High-leverage distributed systems, Go patterns & autonomous agent orchestration.</p>
            <div class="context-links">
              <a href="/showcase" class="context-link">[ EXEC: SHOWCASE ]</a>
              <a href="https://github.com/thiohermes" target="_blank" rel="noreferrer" class="context-link">[ GITHUB: THIOHERMES ]</a>
            </div>
          </div>
        </aside>
      </div>
    </main>

    <footer class="foot wrap">
      <span>© {year} Herdi Agusthio</span>
      <span>Built with Astro</span>
    </footer>

    <script>
      const buttons = document.querySelectorAll('.filter-btn');
      const entries = document.querySelectorAll('.entry-row') as NodeListOf<HTMLElement>;

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          buttons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const filter = btn.getAttribute('data-filter');

          entries.forEach(entry => {
            if (filter === 'all') {
              entry.style.display = '';
            } else {
              const tags = entry.getAttribute('data-tags')?.split(',') || [];
              entry.style.display = tags.includes(filter!) ? '' : 'none';
            }
          });
        });
      });
    </script>

    <style>
      .layout-main-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 280px;
        gap: 3rem;
        align-items: start;
        margin-top: 2rem;
      }
      .sidebar {
        display: flex;
        flex-direction: column;
      }
      .context-panel {
        background: var(--gray-0);
        border: 1px solid var(--gray-20);
        padding: 1.5rem;
      }
      .context-panel h3 {
        font-size: 0.9rem;
        margin-bottom: 0.75rem;
        color: var(--gray-80);
      }
      .context-panel p {
        color: var(--gray-60);
        font-size: 0.85rem;
        line-height: 1.6;
        margin-bottom: 1.25rem;
      }
      .context-links {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .context-link {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: var(--gray-100);
        text-decoration: none;
        border: 1px solid var(--gray-30);
        padding: 0.5rem 0.75rem;
        display: inline-block;
        transition: background 0.2s, border-color 0.2s;
      }
      .context-link:hover {
        background: var(--gray-10);
        border-color: var(--gray-60);
      }
      @media (max-width: 900px) {
        .layout-main-grid {
          grid-template-columns: 1fr;
        }
        .sidebar {
          border-top: 1px dashed var(--gray-30);
          padding-top: 2rem;
          margin-top: 1rem;
        }
      }
      
      .feed-filters {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 2rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        align-items: center;
      }
      .mono-bracket {
        color: var(--gray-50);
      }
      .filter-btn {
        background: none;
        border: none;
        color: var(--gray-50);
        cursor: pointer;
        padding: 0;
        font-family: inherit;
        font-size: inherit;
        text-transform: uppercase;
        transition: color 0.2s;
      }
      .filter-btn:hover {
        color: var(--gray-80);
      }
      .filter-btn.active {
        color: var(--gray-100);
        font-weight: 600;
      }
    </style>
  </body>
</html>