---
import '../styles/global.css';
import FeedEntry from '../components/FeedEntry.astro';
import Hero from '../components/Hero.astro';
import { getFeed } from '../lib/feed';

const feed = getFeed();
const year = new Date().getFullYear();
const faviconHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Herdi Agusthio — Senior Software Engineer</title>
    <meta
      name="description"
      content="Senior Software Engineer focusing on high-leverage distributed systems and engineering excellence."
    />
    <link rel="icon" href={faviconHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap">
        <span class="brand">thio.dev</span>
        <nav class="nav-links">
          <a href="#writing">Archive</a>
          <a href="https://github.com/thiohermes">GitHub</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <Hero />

      <h2 class="section-head" id="writing">
        Knowledge Archive · {feed.length}
      </h2>

      <section class="feed">
        {feed.length === 0 ? (
          <p class="empty">No entries yet.</p>
        ) : (
          feed.map((entry) => <FeedEntry entry={entry} />)
        )}
      </section>
    </main>

    <footer class="foot wrap">
      <span>© {year} Herdi Agusthio</span>
      <span>Built with Astro</span>
    </footer>
  </body>
</html>
