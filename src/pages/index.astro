---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { getEntries } from '../lib/content';
import { engineeringPrinciples, timeline, verifiedProjects } from '../data/homepage';

const [blog, engineering, decisions] = await Promise.all([
  getEntries('blog'),
  getEntries('engineering'),
  getEntries('decisions'),
]);
const themes = Array.from(new Set(blog.flatMap((item) => item.tags))).slice(0, 8);
const featuredArticles = blog.slice(0, 3);
const featured = engineering.filter((item) => item.featured);
const featuredSystems = (featured.length ? featured : engineering).slice(0, 3);
const decisionItems = decisions.slice(0, 4);
---
<BaseLayout
  title="thio.dev — Engineering lab notebook and operating system"
  description="An engineering lab notebook and operating system covering AI agents, infrastructure, Go engineering, security, architecture, and lessons learned."
  canonicalPath="/"
  schemaType="WebSite"
  active="home"
>
  <main id="main" class="wrap homepage">
    <Hero />
    <section class="proof-strip" aria-label="Site scope">
      <span>AI agents</span>
      <span>Infrastructure</span>
      <span>Go engineering</span>
      <span>Security</span>
      <span>Architecture</span>
    </section>

    <section class="intro-block" aria-labelledby="thesis-title">
      <p class="section-kicker">Engineering thesis</p>
      <h2 id="thesis-title">Build systems that stay legible when they matter.</h2>
      <p>
        thio.dev is a working record of systems built, decisions made, and lessons retained. No unverified performance claims; project entries link to the strongest available evidence.
      </p>
    </section>

    <section class="content-section" aria-labelledby="systems-title">
      <div class="section-head-row">
        <h2 id="systems-title" class="section-head">Featured systems</h2>
        <a href="/showcase" class="view-all-link">All systems ({engineering.length}) →</a>
      </div>
      <div class="system-grid">
        {verifiedProjects.map((project) => (
          <article class="system-card">
            <p class="card-kicker">{project.kind}</p>
            <h3><a href={project.href}>{project.name}</a></h3>
            <p>{project.description}</p>
            {project.evidence && <a href={project.evidence}>Evidence</a>}
          </article>
        ))}
      </div>
    </section>

    <section class="content-section" aria-labelledby="principles-title">
      <div class="section-head-row">
        <h2 id="principles-title" class="section-head">How the work gets done</h2>
      </div>
      <ul class="principles-list">
        {engineeringPrinciples.map((principle) => <li>{principle}</li>)}
      </ul>
    </section>

    <section class="content-section" aria-labelledby="timeline-title">
      <div class="section-head-row">
        <h2 id="timeline-title" class="section-head">The trajectory</h2>
      </div>
      <ol class="timeline">
        {timeline.map((entry) => (
          <li>
            <span class="timeline-label">{entry.label}</span>
            <div>
              <h3>{entry.title}</h3>
              <p>{entry.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="content-section" aria-labelledby="writing-title">
      <div class="section-head-row">
        <h2 id="writing-title" class="section-head">Writing by theme</h2>
        <a href="/blog" class="view-all-link">All writing ({blog.length}) →</a>
      </div>
      <div class="theme-list" aria-label="Article themes">
        {themes.map((theme) => <a href={`/blog#${encodeURIComponent(theme)}`}>#{theme}</a>)}
      </div>
      <div class="article-list">
        {featuredArticles.map((item) => (
          <article>
            <p class="card-kicker">
              {item.date} · {item.readingTimeMinutes} min read
              {item.lang === 'id' && <span class="lang-badge"> · [<abbr title="Bahasa Indonesia">ID</abbr>]</span>}
            </p>
            <h3 lang={item.lang}><a href={item.url}>{item.title}</a></h3>
            <p lang={item.lang}>{item.summaryText}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section" aria-labelledby="notes-title">
      <div class="section-head-row">
        <h2 id="notes-title" class="section-head">Recent case notes</h2>
        <a href="/showcase" class="view-all-link">View all case studies ({engineering.length}) →</a>
      </div>
      <div class="article-list">
        {featuredSystems.map((item) => (
          <article>
            <p class="card-kicker">{item.date} · {item.tags.slice(0, 2).join(' · ')}</p>
            <h3><a href={item.url}>{item.title}</a></h3>
            <p>{item.summaryText}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section" aria-labelledby="adr-title">
      <div class="section-head-row">
        <h2 id="adr-title" class="section-head">Recent Architecture Decisions (ADRs)</h2>
        <a href="/decisions" class="view-all-link">Browse all ADRs ({decisions.length}) →</a>
      </div>
      <div class="adr-compact-list">
        {decisionItems.map((adr) => (
          <a href={adr.url} class="adr-compact-row">
            <div class="adr-left">
              <span class="adr-date">[{adr.date}]</span>
              <strong class="adr-title">{adr.title}</strong>
            </div>
            <span class="adr-status">[{adr.status.toUpperCase()} →]</span>
          </a>
        ))}
      </div>
    </section>
  </main>
  <span slot="footer">Built with Astro · Static by default</span>
</BaseLayout>

<style>
  .homepage { padding-bottom: 2rem; }
  .proof-strip { display: flex; flex-wrap: wrap; gap: .6rem 1.4rem; border-block: 1px solid var(--gray-20); padding: .9rem 0; color: var(--gray-60); font: .76rem var(--font-mono); }
  .proof-strip span:not(:last-child)::after { content: ' /'; color: var(--gray-30); margin-left: 1.4rem; }
  .intro-block { max-width: 50rem; padding: 5rem 0 3rem; }
  .section-kicker, .card-kicker { color: #38bdf8; font: .76rem var(--font-mono); margin-bottom: .7rem; }
  .intro-block h2 { font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.1; margin-bottom: 1rem; }
  .intro-block > p:last-child { color: var(--gray-70); font-size: 1.08rem; line-height: 1.7; max-width: 42rem; }
  .content-section { margin-top: 3.5rem; }
  .section-head-row { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; border-bottom: 1px solid var(--gray-20); padding-bottom: .65rem; margin-bottom: 1.25rem; }
  .section-head { font-size: 1.35rem; }
  .view-all-link { color: var(--gray-60); font: .78rem var(--font-mono); text-decoration: none; }
  .view-all-link:hover { color: var(--gray-100); text-decoration: underline; }
  .system-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .system-card, .article-list article { border: 1px solid var(--gray-20); padding: 1.25rem; background: var(--gray-0); }
  .system-card:first-child { grid-row: span 2; background: linear-gradient(145deg, #07131a, var(--gray-0) 65%); }
  .system-card h3, .article-list h3 { font-size: 1.15rem; margin-bottom: .55rem; }
  .system-card p:last-of-type, .article-list p:last-child { color: var(--gray-70); line-height: 1.6; }
  .system-card a, .article-list a { color: var(--gray-100); text-decoration: none; }
  .system-card a:hover, .article-list a:hover { text-decoration: underline; }
  .principles-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; list-style: none; }
  .principles-list li { border-top: 2px solid #38bdf8; padding-top: .8rem; color: var(--gray-80); line-height: 1.55; }
  .timeline { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .timeline li { display: flex; gap: .8rem; border-left: 1px solid var(--gray-30); padding-left: 1rem; }
  .timeline-label { color: #10b981; font: .8rem var(--font-mono); }
  .timeline h3 { margin-bottom: .4rem; }
  .timeline p { color: var(--gray-70); line-height: 1.5; }
  .theme-list { display: flex; flex-wrap: wrap; gap: .55rem; margin-bottom: 1rem; }
  .theme-list a { border: 1px solid var(--gray-30); padding: .45rem .65rem; color: var(--gray-80); font: .78rem var(--font-mono); text-decoration: none; }
  .theme-list a:hover { border-color: #38bdf8; color: var(--gray-100); }
  .article-list { display: grid; gap: 1rem; }
  @media (max-width: 700px) { .system-grid, .principles-list, .timeline { grid-template-columns: 1fr; } .system-card:first-child { grid-row: auto; } .intro-block { padding-top: 3rem; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; } }
</style>
