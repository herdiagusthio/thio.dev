---
import '../styles/global.css';
import FeedEntry from '../components/FeedEntry.astro';
import Portfolio from '../components/Portfolio.astro';
import { getFeed } from '../lib/feed';

const feed = getFeed();
const year = 2026; // build-time constant; bump as needed
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Herdi Agusthio — Software Engineer</title>
    <meta
      name="description"
      content="Technical thinking, engineering experience, and professional journey of Herdi Agusthio."
    />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\\/$/, '')}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=JetBrains+Mono:wght@400;600&family=Plus+Jakarta+Sans:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap">
        <span class="brand">thio<span class="dot">.</span>dev</span>
        <nav class="nav-links">
          <a href="#portfolio">Portfolio</a>
          <a href="#writing">Writing</a>
          <a href="#about">About</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <section class="hero">
        <p class="eyebrow">// Senior Backend Engineer · Distributed Systems · AI Infra</p>
        <h1>Herdi <span class="grad">Agusthio</span></h1>
        <p>
          I build high-leverage backend systems. This platform is a living 
          representation of my thinking, engineering capability, and the 
          professional journey of solving complex distributed problems.
        </p>
      </section>

      <Portfolio />

      <h2 class="section-head" id="writing">
        knowledge archive · {feed.length} {feed.length === 1 ? 'entry' : 'entries'}
      </h2>

      <section class="feed">
        {feed.length === 0 ? (
          <p class="empty">No entries yet. Run `npm run sync` to pull the latest.</p>
        ) : (
          feed.map((entry) => <FeedEntry entry={entry} />)
        )}
      </section>
    </main>

    <footer class="foot wrap">
      <span>© {year} Herdi Agusthio</span>
      <span class="foot-tech">built with astro · deployed on github pages</span>
    </footer>
  </body>
</html>
