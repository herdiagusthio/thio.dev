---
import '../styles/global.css';

const faviconHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact Operator — thio.dev</title>
    <meta name="description" content="Get in touch via LinkedIn or GitHub." />
    <link rel="icon" href={faviconHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap topbar-inner">
        <span class="brand"><a href="/" class="nav-brand" style="text-decoration:none; color:inherit;">thio.dev</a></span>
        <nav class="nav-links">
          <a href="/showcase">Showcase</a>
          <a href="/office">Office</a>
          <a href="/blog">Blog</a>
          <a href="/about">About</a>
          <a href="/contact" class="active-nav">Contact</a>
        </nav>
      </div>
    </header>

    <main class="wrap main-container">
      <section class="page-hero">
        <div class="meta-status">
          <span class="status-indicator"></span>
          <span class="mono-label">[SYS_OPERATOR: COMMS_PROTOCOL]</span>
        </div>
        <h1 class="page-title">Establish Connection</h1>
        <p class="hero-desc">
          I'm always open to discussing distributed systems, architecture roles, or high-leverage engineering opportunities. Pick a channel below to initiate contact.
        </p>
      </section>

      <div class="contact-links">
        <a href="mailto:herdiagusthio@gmail.com" class="contact-card">
          <div class="card-icon">[ EMAIL ]</div>
          <div class="card-content">
            <h2 class="card-title">Direct Communication</h2>
            <p class="card-desc">herdiagusthio@gmail.com</p>
          </div>
        </a>

        <a href="https://www.linkedin.com/in/herdiagusthio/" target="_blank" rel="noreferrer" class="contact-card">
          <div class="card-icon">[ LINKEDIN ]</div>
          <div class="card-content">
            <h2 class="card-title">Professional Network</h2>
            <p class="card-desc">Connect for career opportunities and professional inquiries.</p>
          </div>
        </a>

        <a href="https://github.com/herdiagusthio" target="_blank" rel="noreferrer" class="contact-card">
          <div class="card-icon">[ GITHUB ]</div>
          <div class="card-content">
            <h2 class="card-title">Code Repositories</h2>
            <p class="card-desc">Review open-source contributions and active projects.</p>
          </div>
        </a>
      </div>
    </main>

    <footer class="foot wrap">
      <span>© 2026 Herdi Agusthio</span>
      <a href="/" class="back-link">[ ← RETURN TO CONSOLE ]</a>
    </footer>
  </body>
</html>

<style>
  .topbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .active-nav {
    color: var(--gray-100);
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 600;
  }
  .main-container {
    padding-top: 2rem;
    padding-bottom: 4rem;
    max-width: 800px;
  }
  .page-hero {
    margin-bottom: 3rem;
  }
  .meta-status {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--gray-60);
    margin-bottom: 1rem;
  }
  .status-indicator {
    width: 8px;
    height: 8px;
    background: var(--gray-100);
    border-radius: 50%;
  }
  .page-title {
    font-family: var(--font-sans);
    font-size: clamp(2.2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--gray-100);
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  .hero-desc {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--gray-70);
    max-width: 48rem;
  }
  
  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .contact-card {
    display: flex;
    align-items: center;
    gap: 2rem;
    background: var(--gray-0);
    border: 1px solid var(--gray-20);
    padding: 2rem;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .contact-card:hover {
    border-color: var(--gray-60);
    background: var(--gray-10);
  }
  @media (max-width: 600px) {
    .contact-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.5rem;
    }
  }
  
  .card-icon {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--gray-100);
    font-weight: 600;
    min-width: 120px;
  }
  
  .card-title {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--gray-100);
    margin-bottom: 0.25rem;
  }
  .contact-card:hover .card-title {
    text-decoration: underline;
  }
  .card-desc {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--gray-60);
  }

  .back-link {
    text-decoration: none;
    color: var(--gray-80);
    font-family: var(--font-mono);
  }
  .back-link:hover {
    color: var(--gray-100);
  }
</style>
