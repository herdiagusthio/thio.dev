---
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';
import { marked } from 'marked';
import '../../styles/global.css';

export async function getStaticPaths() {
  const engDir = path.resolve(process.cwd(), 'content/engineering');
  const files = fs.readdirSync(engDir).filter(f => f.endsWith('.md') && f !== 'project-alpha.md');
  
  return files.map(file => {
    const slug = file.replace('.md', '');
    return { params: { slug } };
  });
}

function formatDate(val: unknown): string {
  if (!val) return '';
  if (val instanceof Date) return val.toISOString().split('T')[0];
  const str = String(val).trim();
  const match = str.match(/^\d{4}-\d{2}-\d{2}/);
  return match ? match[0] : str;
}

const { slug } = Astro.params;
const filePath = path.resolve(process.cwd(), `content/engineering/${slug}.md`);
const fileContent = fs.readFileSync(filePath, 'utf8');
const { data, content } = matter(fileContent);
const html = marked.parse(content);

const formattedDate = formatDate(data.date);
const faviconHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{data.title} — Engineering Case Study</title>
    <link rel="icon" href={faviconHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap topbar-inner">
        <nav class="nav-links">
          <a href="/" class="nav-brand">← System Console</a>
          <span class="sep">/</span>
          <a href="/showcase" class="nav-brand">Showcase</a>
        </nav>
        <span class="topbar-tag">[SYSTEM ARCHITECTURE & LAB]</span>
      </div>
    </header>

    <main class="wrap main-container">
      <article class="case-study-content">
        <header class="article-header">
          <div class="meta-row">
            <span class="eyebrow">[CASE STUDY]</span>
            {formattedDate && <span class="eyebrow">[{formattedDate}]</span>}
            <span class="status-pill">[PUBLISHED]</span>
          </div>
          <h1>{data.title}</h1>
          {data.summary && (
            <p class="summary-lead">{data.summary}</p>
          )}
          {data.tags && data.tags.length > 0 && (
            <div class="tags-row">
              {data.tags.map((t: string) => (
                <span class="tag-badge">#{t}</span>
              ))}
            </div>
          )}
        </header>
        
        <div class="prose" set:html={html} />
      </article>
    </main>

    <footer class="foot wrap">
      <span>© 2026 Herdi Agusthio · Principal Software Engineer</span>
      <a href="/showcase" class="back-link">[ ← RETURN TO SHOWCASE ]</a>
    </footer>
  </body>
</html>

<style>
  .topbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .topbar-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--gray-50);
  }
  .sep {
    color: var(--gray-40);
  }
  .main-container {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }
  .article-header {
    padding: 2rem 0 2rem;
    border-bottom: 1px solid var(--gray-20);
    margin-bottom: 2.5rem;
  }
  .meta-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    font-family: var(--font-mono);
  }
  .eyebrow {
    font-size: 0.8rem;
    color: var(--gray-60);
  }
  .status-pill {
    font-size: 0.8rem;
    color: var(--gray-100);
    font-weight: 600;
  }
  h1 {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--gray-100);
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  .summary-lead {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--gray-80);
    margin-bottom: 1.25rem;
    max-width: 50rem;
  }
  .tags-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--gray-60);
  }
  .tag-badge {
    color: var(--gray-60);
  }
  .prose {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--gray-80);
    max-width: 50rem;
  }
  .prose :global(h1) {
    display: none; /* Hide duplicate h1 inside markdown if already rendered in header */
  }
  .prose :global(h2) {
    font-family: var(--font-mono);
    color: var(--gray-100);
    margin: 2.5rem 0 1rem;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    border-bottom: 1px dashed var(--gray-20);
    padding-bottom: 0.5rem;
  }
  .prose :global(h3) {
    font-family: var(--font-mono);
    color: var(--gray-90);
    margin: 2rem 0 0.75rem;
    font-size: 1.15rem;
  }
  .prose :global(p) {
    margin-bottom: 1.25rem;
  }
  .prose :global(ul) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .prose :global(li) {
    margin-bottom: 0.5rem;
  }
  .prose :global(pre) {
    background: var(--gray-10);
    border: 1px solid var(--gray-20);
    padding: 1rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    background: var(--gray-10);
    padding: 0.2rem 0.4rem;
    font-size: 0.88em;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
  .back-link {
    text-decoration: none;
    color: var(--gray-80);
  }
  .back-link:hover {
    color: var(--gray-100);
  }
</style>
