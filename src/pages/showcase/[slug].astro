---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getEntries } from '../../lib/content';

export async function getStaticPaths() {
  const items = await getEntries('engineering');
  return items.map((item, idx) => ({
    params: { slug: item.slug },
    props: {
      item,
      prev: idx < items.length - 1 ? { title: items[idx + 1].title, url: `/showcase/${items[idx + 1].slug}`, label: 'CASE STUDY' } : null,
      next: idx > 0 ? { title: items[idx - 1].title, url: `/showcase/${items[idx - 1].slug}`, label: 'CASE STUDY' } : null,
    },
  }));
}

const { item, prev, next } = Astro.props;
const { Content } = await render(item.entry);
---
<ArticleLayout
  item={item}
  active="showcase"
  seoTitle={`${item.title} — Engineering Case Study (thio.dev)`}
  canonicalPath={`/showcase/${item.slug}`}
  schemaType="TechArticle"
  eyebrow="CASE STUDY"
  back={{ href: '/showcase', label: '[ ← RETURN TO SHOWCASE ]' }}
  prev={prev}
  next={next}
>
  <Content />
</ArticleLayout>
