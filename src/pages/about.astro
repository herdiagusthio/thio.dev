---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AGENTS as fleet } from '../data/agents';
---
<BaseLayout
  title="About Herdi Agusthio — Software Engineer & Systems Architect (thio.dev)"
  description="Software Engineer at Flip with nearly a decade of experience across ByteDance, Tokopedia, and GoTo specializing in high-concurrency Go systems and autonomous multi-agent engineering organizations."
  canonicalPath="/about"
  schemaType="ProfilePage"
  active="about"
>

    <main id="main" class="wrap main-container">
      <section class="page-hero">
        <div class="meta-status">
          <span class="status-indicator"></span>
          <span class="mono-label">[SYS_OPERATOR: BIO_DATA]</span>
        </div>
        <h1 class="page-title">Herdi Agusthio Putra Darmawan</h1>
        <div class="prose">
          <p>
            I am a Software Engineer based in West Java, Indonesia, currently building high-performance systems at <strong>Flip</strong>.
          </p>
          <p>
            With nearly a decade of experience across leading tech companies (<strong>ByteDance</strong>, <strong>Tokopedia</strong>, <strong>GoTo</strong>), my core focus is on architectural purity, high-concurrency Go services, distributed systems, and orchestrating autonomous AI engineering organizations.
          </p>
          <p>
            This site serves as my system console—a durable knowledge base and architecture lab where I document production blueprints, Architectural Decision Records (ADRs), and engineering reflections.
          </p>
        </div>
      </section>

      <div class="content-grid">
        <!-- Skills -->
        <section class="content-section">
          <h2 class="section-head">Core Protocols (Skills)</h2>
          <div class="skills-grid">
            <div class="skill-block">
              <h3 class="skill-title">[ LANGUAGES &amp; RUNTIMES ]</h3>
              <p class="skill-list">Go (Golang), TypeScript / Bun, Java (gRPC), Ruby on Rails, Python</p>
            </div>
            <div class="skill-block">
              <h3 class="skill-title">[ DATA &amp; MESSAGING ]</h3>
              <p class="skill-list">PostgreSQL, Redis, SQLite (WAL), NSQ, Kafka</p>
            </div>
            <div class="skill-block">
              <h3 class="skill-title">[ INFRASTRUCTURE &amp; AI ORG ]</h3>
              <p class="skill-list">Linux Kernel Tuning (BBR / Cgroups), Caddy, Kubernetes, Multi-Agent SDLC</p>
            </div>
            <div class="skill-block">
              <h3 class="skill-title">[ EDUCATION ]</h3>
              <p class="skill-list">B.S. Computer Science — IPB University</p>
            </div>
          </div>
        </section>

        <!-- Autonomous Agent Organization -->
        <section class="content-section">
          <h2 class="section-head">Autonomous 7-Agent Workforce</h2>
          <div class="fleet-list">
            {fleet.map((agent) => (
              <div class="fleet-row">
                <div class="fleet-main">
                  <strong class="fleet-name">{agent.name}</strong>
                  <span class="fleet-role">{agent.role}</span>
                </div>
                <span class="fleet-focus">{agent.focus}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- Experience -->
        <section class="content-section">
          <h2 class="section-head">Execution History</h2>
          
          <div class="timeline">
            <!-- Flip -->
            <div class="timeline-item">
              <div class="timeline-meta">
                <span class="timeline-date">[ 2026 - PRES ]</span>
              </div>
              <div class="timeline-content">
                <h3 class="timeline-role">Software Engineer</h3>
                <p class="timeline-company">Flip</p>
                <p class="timeline-desc">Part of the Lifestyle Team building reliable, high-throughput financial and consumer services.</p>
              </div>
            </div>

            <!-- ByteDance / GoTo Logistics -->
            <div class="timeline-item">
              <div class="timeline-meta">
                <span class="timeline-date">[ 2024 - 2025 ]</span>
              </div>
              <div class="timeline-content">
                <h3 class="timeline-role">Software Engineer</h3>
                <p class="timeline-company">ByteDance &amp; GoTo Logistics</p>
                <p class="timeline-desc">Global E-Commerce – Supply Chain and Logistics (Dilayani Tokopedia).</p>
              </div>
            </div>

            <!-- Tokopedia / GoTo Financial -->
            <div class="timeline-item">
              <div class="timeline-meta">
                <span class="timeline-date">[ 2022 - 2024 ]</span>
              </div>
              <div class="timeline-content">
                <h3 class="timeline-role">Software Engineer</h3>
                <p class="timeline-company">Tokopedia &amp; GoTo Financial</p>
                <p class="timeline-desc">Core Payment team and GoPay Merchant Gateway.</p>
              </div>
            </div>

            <!-- Nusantara Baskara Jaya -->
            <div class="timeline-item">
              <div class="timeline-meta">
                <span class="timeline-date">[ 2016 - 2021 ]</span>
              </div>
              <div class="timeline-content">
                <h3 class="timeline-role">Backend Developer</h3>
                <p class="timeline-company">Nusantara Baskara Jaya</p>
                <p class="timeline-desc">Ruby on Rails developer for ilmupedia.co.id.</p>
              </div>
            </div>
          </div>
        </section>
      </div>
    </main>
    <a slot="footer" href="/" class="back-link">[ ← RETURN TO CONSOLE ]</a>
</BaseLayout>

<style>
  .page-hero {
    border-bottom: 1px dashed var(--gray-30);
    padding-bottom: 2rem;
    margin-bottom: 3rem;
  }
  .page-title {
    margin-bottom: 1.5rem;
  }
  .content-grid {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }
  .section-head {
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
    border-bottom: 2px solid var(--gray-20);
    padding-bottom: 0.5rem;
  }
  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
  }
  @media (max-width: 600px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
  .skill-title {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: #38bdf8;
    margin-bottom: 0.45rem;
    font-weight: 600;
  }
  .skill-list {
    font-family: var(--font-sans);
    font-size: 1.02rem;
    color: var(--gray-90);
    line-height: 1.5;
  }
  .fleet-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--gray-20);
  }
  .fleet-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.15rem;
    border-bottom: 1px solid var(--gray-20);
    flex-wrap: wrap;
  }
  .fleet-row:last-child {
    border-bottom: none;
  }
  .fleet-main {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .fleet-name {
    font-family: var(--font-mono);
    color: var(--gray-100);
    font-size: 0.95rem;
  }
  .fleet-role {
    font-family: var(--font-mono);
    color: #38bdf8;
    font-size: 0.78rem;
  }
  .fleet-focus {
    font-size: 0.88rem;
    color: var(--gray-60);
  }
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }
  .timeline-item {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 1.5rem;
  }
  @media (max-width: 600px) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
  .timeline-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--gray-50);
  }
  .timeline-role {
    font-family: var(--font-sans);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--gray-100);
    margin-bottom: 0.25rem;
  }
  .timeline-company {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--gray-70);
    margin-bottom: 0.6rem;
  }
  .timeline-desc {
    font-family: var(--font-sans);
    font-size: 0.98rem;
    color: var(--gray-60);
    line-height: 1.5;
  }
</style>
