---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getEntries } from '../../lib/content';

export async function getStaticPaths() {
  const adrs = await getEntries('decisions');
  return adrs.map((adr, idx) => ({
    params: { slug: adr.slug },
    props: {
      adr,
      prev: idx < adrs.length - 1 ? { title: adrs[idx + 1].title, url: `/decisions/${adrs[idx + 1].slug}`, label: 'ADR' } : null,
      next: idx > 0 ? { title: adrs[idx - 1].title, url: `/decisions/${adrs[idx - 1].slug}`, label: 'ADR' } : null,
    },
  }));
}

const { adr, prev, next } = Astro.props;
const { Content } = await render(adr.entry);
---
<ArticleLayout
  item={adr}
  active="showcase"
  seoTitle={`${adr.title} — Architectural Decision Record (thio.dev)`}
  canonicalPath={`/decisions/${adr.slug}`}
  schemaType="TechArticle"
  eyebrow="DECISION RECORD"
  statusLabel={adr.status.toUpperCase()}
  showSummary={false}
  back={{ href: '/decisions', label: '[ ← ALL DECISION RECORDS ]' }}
  prev={prev}
  next={next}
>
  <Content />
</ArticleLayout>
