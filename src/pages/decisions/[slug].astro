---
import '../../styles/global.css';
import SeoHead from '../../components/SeoHead.astro';
import Topbar from '../../components/Topbar.astro';
import ArticleEnhancer from '../../components/ArticleEnhancer.astro';
import { getDecisions } from '../../lib/feed';

export async function getStaticPaths() {
  const adrs = getDecisions();
  return adrs.map((adr, idx) => ({
    params: { slug: adr.slug },
    props: {
      adr,
      prev: idx < adrs.length - 1 ? { title: adrs[idx + 1].title, url: `/decisions/${adrs[idx + 1].slug}`, label: 'ADR' } : null,
      next: idx > 0 ? { title: adrs[idx - 1].title, url: `/decisions/${adrs[idx - 1].slug}`, label: 'ADR' } : null,
    },
  }));
}

const { adr, prev, next } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <SeoHead
      title={`${adr.title} — Architectural Decision Record (thio.dev)`}
      description={adr.summaryText}
      canonicalPath={`/decisions/${adr.slug}`}
      ogType="article"
      publishedDate={adr.date}
      tags={adr.tags}
      readingTimeMinutes={adr.readingTimeMinutes}
      schemaType="TechArticle"
    />
  </head>
  <body>
    <Topbar active="showcase" />

    <main class="wrap main-container">
      <article class="decision-content">
        <header class="article-header">
          <div class="meta-row">
            <span class="eyebrow">[DECISION RECORD]</span>
            {adr.date && <span class="eyebrow">[{adr.date}]</span>}
            <span class="reading-pill">⏱ {adr.readingTimeMinutes} MIN READ</span>
            <span class="status-pill">[ACCEPTED]</span>
          </div>
          <h1>{adr.title}</h1>
          {adr.tags && adr.tags.length > 0 && (
            <div class="tags-row">
              {adr.tags.map((t: string) => (
                <span class="tag-badge">#{t}</span>
              ))}
            </div>
          )}
        </header>
        
        <div class="prose" set:html={adr.bodyHtml} />
      </article>

      <ArticleEnhancer
        prev={prev}
        next={next}
        backHref="/showcase#adrs"
        backLabel="[ ← RETURN TO ADR CATALOG ]"
      />
    </main>

    <style>
      .main-container {
        padding-top: 2rem;
        padding-bottom: 2rem;
      }
      .article-header {
        padding: 1.5rem 0 2rem;
        border-bottom: 1px solid var(--gray-20);
        margin-bottom: 2.5rem;
      }
      .meta-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
        font-family: var(--font-mono);
      }
      .eyebrow {
        font-size: 0.78rem;
        color: var(--gray-60);
      }
      .reading-pill {
        font-size: 0.78rem;
        color: #38bdf8;
        font-weight: 600;
      }
      .status-pill {
        font-size: 0.78rem;
        color: #10b981;
        font-weight: 600;
      }
      h1 {
        font-family: var(--font-sans);
        font-size: clamp(2rem, 5vw, 2.75rem);
        font-weight: 800;
        letter-spacing: -0.04em;
        color: var(--gray-100);
        line-height: 1.2;
        margin-bottom: 1rem;
      }
      .tags-row {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        color: var(--gray-60);
      }
    </style>
  </body>
</html>
