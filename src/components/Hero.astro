---
import { getPulseData } from "../lib/telemetry";

const pulse = getPulseData();
---
<section class="hero-console">
  <!-- System Status Bar -->
  <div class="sys-header">
    <div class="sys-pulse">
      <span class="pulse-indicator"></span>
      <span class="signal-text">{pulse.signal}</span>
      <span class="host-pill">[{pulse.host}]</span>
      <span class="host-pill">[7-AGENT FLEET]</span>
    </div>
    <div class="sys-status-meta">
      <span class="auth-level">[{pulse.memoryGuard}]</span>
      <span class="ts-label">[TS:{pulse.timestamp}]</span>
    </div>
  </div>
  
  <!-- Operator Profile -->
  <div class="sys-operator">
    <div class="operator-dossier">
      <h1 class="operator-name">Herdi Agusthio</h1>
      <p class="operator-role">&gt; Software Engineer &amp; Systems Architect</p>
      <p class="operator-bio">
        Software Engineer at <strong>Flip</strong> with nearly a decade of experience scaling high-concurrency backend systems across ByteDance, Tokopedia, and GoTo. Focused on architectural purity, distributed Go services, and orchestrating autonomous multi-agent engineering organizations.
      </p>
    </div>
  </div>

  <!-- Action Commands -->
  <div class="sys-actions">
    <a href="/showcase" class="cmd-btn primary">[ EXEC: SHOWCASE &amp; ADRs ]</a>
    <a href="/office" class="cmd-btn highlight">[ LAUNCH: 2D/3D AGENT OFFICE ]</a>
    <a href="/blog" class="cmd-btn secondary">[ EXEC: BLOG ]</a>
    <a href="/k8s/" class="cmd-btn secondary">[ PLAY: KUBEQUEST ☸️ ]</a>
  </div>
</section>

<style>
  .hero-console {
    background: var(--gray-0);
    color: var(--gray-100);
    font-family: var(--font-mono);
    border: 1px solid var(--gray-20);
    padding: 2rem;
    margin: 2rem 0;
  }
  
  .sys-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
    color: var(--gray-50);
    border-bottom: 1px dashed var(--gray-20);
    padding-bottom: 1rem;
    margin-bottom: 1.75rem;
  }
  
  .sys-pulse {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  
  .pulse-indicator {
    width: 8px;
    height: 8px;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
    border-radius: 50%;
    animation: blink 2s steps(2, start) infinite;
  }
  
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .host-pill {
    color: var(--gray-60);
  }

  .sys-status-meta {
    display: flex;
    gap: 0.85rem;
  }
  
  .sys-operator {
    margin-bottom: 2rem;
  }

  .operator-name {
    font-family: var(--font-sans);
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    letter-spacing: -0.05em;
    color: var(--gray-100);
    line-height: 1.1;
  }
  
  .operator-role {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: #38bdf8;
    margin-bottom: 1.25rem;
    font-weight: 600;
  }
  
  .operator-bio {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    color: var(--gray-80);
    line-height: 1.65;
    max-width: 48rem;
  }
  .operator-bio strong {
    color: var(--gray-100);
  }
  
  .sys-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
  
  .cmd-btn {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-decoration: none;
    padding: 0.6rem 1.1rem;
    transition: all 0.2s;
    font-weight: 600;
  }
  
  .cmd-btn.primary {
    background: var(--gray-100);
    color: var(--gray-0);
    border: 1px solid var(--gray-100);
  }
  
  .cmd-btn.primary:hover {
    background: var(--gray-80);
    border-color: var(--gray-80);
  }
  
  .cmd-btn.secondary {
    color: var(--gray-90);
    border: 1px solid var(--gray-30);
    background: var(--gray-0);
  }
  
  .cmd-btn.secondary:hover {
    color: var(--gray-100);
    border-color: var(--gray-60);
    background: var(--gray-10);
  }

  .cmd-btn.highlight {
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.45);
    background: rgba(56, 189, 248, 0.08);
  }

  .cmd-btn.highlight:hover {
    color: #ffffff;
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.2);
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.25);
  }

  @media (max-width: 900px) {
    .sys-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .sys-status-meta {
      flex-wrap: wrap;
    }
  }

  @media (max-width: 600px) {
    .operator-name {
      font-size: 2rem;
    }
    .sys-actions {
      flex-direction: column;
      width: 100%;
    }
    .cmd-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
