---
interface Project {
  name: string;
  description: string;
  tech: string[];
  link?: string;
  decisions?: string[];
}

const projects: Project[] = [
  {
    name: "NikahYuk API",
    description: "High-concurrency wedding planning & RSVP system with a focus on atomic consistency and automated guest management.",
    tech: ["Go", "PostgreSQL", "Docker", "GitHub Actions"],
    link: "https://github.com/nikahyukid/nikahyuk-api",
    decisions: ["rsvp-security-uuid", "atomic-guest-count-sync"]
  },
  {
    name: "Personal Brand Engine",
    description: "A professional knowledge publishing system designed as a durable digital asset for engineering credibility.",
    tech: ["Astro", "TypeScript", "Markdown", "Git"],
    decisions: ["git-markdown-ssot", "hybrid-home-layout"]
  }
];
---

<section id="portfolio" class="portfolio">
  <h2 class="section-head">software engineering showcase</h2>
  <div class="project-grid">
    {projects.map(project => (
      <div class="project-card">
        <div class="project-header">
          <h3>{project.name}</h3>
          {project.link && <a href={project.link} class="external-link" target="_blank">↗</a>}
        </div>
        <p class="project-desc">{project.description}</p>
        <div class="project-tech">
          {project.tech.map(t => <span class="tech-pill">{t}</span>)}
        </div>
        {project.decisions && (
          <div class="project-evidence">
            <span class="evidence-label">key decisions:</span>
            <div class="evidence-links">
              {project.decisions.map(d => (
                <a href={`/decisions/${d}`} class="evidence-link">{d}</a>
              ))}
            </div>
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .portfolio {
    padding: 40px 0 72px;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }
  .project-card {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .project-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-4px);
  }
  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
  }
  .project-header h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .external-link {
    font-size: 1.2rem;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }
  .external-link:hover {
    opacity: 1;
  }
  .project-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0 0 20px;
    line-height: 1.5;
  }
  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }
  .tech-pill {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--text-dim);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    padding: 2px 8px;
    border-radius: 4px;
  }
  .project-evidence {
    border-top: 1px solid var(--border);
    padding-top: 16px;
    margin-top: 16px;
  }
  .evidence-label {
    display: block;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--text-dim);
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .evidence-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .evidence-link {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--primary);
    background: rgba(255, 255, 255, 0.05);
    padding: 2px 6px;
    border-radius: 4px;
    transition: background 0.2s ease;
  }
  .evidence-link:hover {
    background: rgba(255, 255, 255, 0.1);
  }
</style>
