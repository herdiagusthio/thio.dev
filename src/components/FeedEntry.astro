---
import type { FeedEntry } from '../lib/feed';
interface Props { entry: FeedEntry }
const { entry } = Astro.props;

const categoryLabel =
  entry.kind === 'decision'
    ? 'DECISION'
    : entry.kind === 'engineering'
    ? 'CASE STUDY'
    : 'SESSION';

const statusClass = entry.status
  ? `status-${entry.status.toLowerCase().split(/\s+/)[0]}`
  : '';
---
<article class="entry-row" data-tags={entry.tags.join(',')}>
  <div class="entry-meta">
    <span class="mono-bracket mono-category">[{categoryLabel}]</span>
    <span class="mono-bracket">[{entry.date}]</span>
    {entry.status && (
      <span class={`mono-bracket ${statusClass}`}>[{entry.status.toUpperCase()}]</span>
    )}
    {entry.tags && entry.tags.map(tag => (
      <span class="mono-bracket tag-item">[{tag.toUpperCase()}]</span>
    ))}
  </div>

  <div class="entry-content">
    <h3 class="mono-title">
      {entry.url ? (
        <a href={entry.url} class="entry-link">{entry.title}</a>
      ) : (
        entry.title
      )}
    </h3>
    <div class="body" set:html={entry.summaryHtml} />
    {entry.bulletsHtml.length > 0 && (
      <ul class="bracket-list">
        {entry.bulletsHtml.map((b) => <li set:html={b} />)}
      </ul>
    )}
  </div>
</article>
<hr class="entry-divider" />

<style>
  .entry-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.5rem;
    padding: 1.5rem 0;
  }
  
  .entry-divider {
    border: none;
    border-bottom: 1px solid var(--gray-20);
    margin: 0;
  }
  
  .entry-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--gray-50);
  }

  .mono-category {
    font-weight: bold;
    color: var(--gray-100);
  }

  .mono-bracket {
    text-transform: uppercase;
  }

  .status-published, .status-accepted {
    color: var(--gray-100);
    font-weight: 600;
  }

  .status-proposed, .status-draft {
    color: var(--gray-50);
  }

  .tag-item {
    color: var(--gray-60);
  }

  .entry-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mono-title {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--gray-100);
  }

  .entry-link {
    color: var(--gray-100);
    text-decoration: none;
    transition: color 0.15s;
  }

  .entry-link:hover {
    color: var(--gray-60);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .body {
    font-family: var(--font-sans);
    color: var(--gray-70);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .bracket-list {
    list-style: none;
    padding-left: 0;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--gray-80);
  }

  .bracket-list li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .bracket-list li::before {
    content: "[>]";
    position: absolute;
    left: 0;
    color: var(--gray-60);
  }

  @media (max-width: 640px) {
    .entry-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    
    .entry-meta {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
  }
</style>