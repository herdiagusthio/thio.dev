---
export interface NavLink {
  title: string;
  url: string;
  label?: string;
}

export interface Props {
  prev?: NavLink | null;
  next?: NavLink | null;
}

const { prev = null, next = null } = Astro.props;
---
<!-- Top Reading Progress Bar -->
<div class="reading-progress-track" aria-hidden="true">
  <div id="readingProgressBar" class="reading-progress-bar"></div>
</div>

{(prev || next) && (
  <nav class="article-pager" aria-label="Adjacent Articles">
    {prev ? (
      <a href={prev.url} class="pager-card pager-prev">
        <span class="pager-dir">[ ← PREVIOUS {prev.label || 'ENTRY'} ]</span>
        <strong class="pager-title">{prev.title}</strong>
      </a>
    ) : <div />}
    {next ? (
      <a href={next.url} class="pager-card pager-next">
        <span class="pager-dir">[ NEXT {next.label || 'ENTRY'} → ]</span>
        <strong class="pager-title">{next.title}</strong>
      </a>
    ) : <div />}
  </nav>
)}

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Reading progress bar
    const bar = document.getElementById('readingProgressBar');
    if (bar) {
      const updateProgress = () => {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const pct = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
        bar.style.width = pct + '%';
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }

    // 2. Copy button on all <pre> blocks inside .prose
    document.querySelectorAll('.prose pre').forEach((pre) => {
      if (pre.querySelector('.code-copy-btn')) return;
      pre.style.position = 'relative';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy-btn';
      btn.textContent = '[ COPY ]';
      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.innerText || pre.innerText;
        try {
          await navigator.clipboard.writeText(code);
          btn.textContent = '[ COPIED ✓ ]';
          setTimeout(() => { btn.textContent = '[ COPY ]'; }, 1800);
        } catch {
          btn.textContent = '[ ERROR ]';
        }
      });
      pre.appendChild(btn);
    });
  });
</script>

<style>
  .reading-progress-track {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.06);
    z-index: 999;
  }
  .reading-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #10b981, #38bdf8);
    transition: width 0.08s linear;
  }
  .article-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px dashed var(--gray-20);
  }
  @media (max-width: 640px) {
    .article-pager {
      grid-template-columns: 1fr;
    }
  }
  .pager-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem;
    border: 1px solid var(--gray-20);
    background: var(--gray-0);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .pager-card:hover {
    border-color: var(--gray-60);
    background: var(--gray-10);
  }
  .pager-next {
    text-align: right;
  }
  .pager-dir {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--gray-50);
  }
  .pager-title {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--gray-100);
    line-height: 1.35;
  }
</style>
